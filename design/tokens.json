      "bg": "#E6E7DC", "ink": "#2A2C24", "ink2": "#63665A", "line": "#D3D5C6", "accent": "#2A2C24",
      "hl": "#F3E3A4", "wave": "#C9604F", "glass": "rgba(234,235,225,.84)", "main": "#2B4C7E", "onMain": "#FFFFFF",
