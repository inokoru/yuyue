{
  "name": "yuyue-midscene-e2e",
  "private": true,
  "version": "0.2.0",
  "description": "Layer 4: Cross-platform visual UI smoke & release suite for Yuyue powered by Midscene.js (Windows, macOS, Android, iOS, Web).",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-flows.mjs",
    "verify:model": "node scripts/run-midscene.mjs --verify-model",
    "render": "node scripts/run-midscene.mjs --platform all --render-only",
    "doctor:windows": "node scripts/run-midscene.mjs --platform windows --doctor",
    "doctor:macos": "node scripts/run-midscene.mjs --platform macos --doctor",
    "doctor:android": "node scripts/run-midscene.mjs --platform android --doctor",
    "doctor:ios": "node scripts/run-midscene.mjs --platform ios --doctor",
    "doctor:web": "node scripts/run-midscene.mjs --platform web --doctor",
    "run:windows": "node scripts/run-midscene.mjs --platform windows",
    "run:macos": "node scripts/run-midscene.mjs --platform macos",
    "run:android": "node scripts/run-midscene.mjs --platform android",
    "run:ios": "node scripts/run-midscene.mjs --platform ios",
    "run:web": "node scripts/run-midscene.mjs --platform web"
  },
  "devDependencies": {
    "@midscene/cli": "^1.18.2"
  }
}
