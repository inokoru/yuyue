# Copy to `.env` (never commit `.env`).
# Midscene uses a Vision-Language Model (VLM) to perceive UI screenshots and drive actions.
# Qwen-VL (DashScope) or UI-TARS are recommended for Chinese UI accuracy.

# --- Option A: Qwen-VL via DashScope (OpenAI-compatible) ---
MIDSCENE_MODEL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
MIDSCENE_MODEL_API_KEY="sk-your-dashscope-key"
MIDSCENE_MODEL_NAME="qwen3-vl-plus"
MIDSCENE_MODEL_FAMILY="qwen3-vl"

# --- Option B: OpenAI / Compatible ---
# OPENAI_API_KEY="sk-..."
# MIDSCENE_MODEL_NAME="gpt-4o"

# --- Platform targets (optional overrides) ---
# Windows: path to built WinUI executable (auto-detected if omitted)
YUYUE_WIN_EXE=""
# Desktop displayId (optional; omit for primary monitor)
MIDSCENE_DISPLAY_ID=""
# macOS: path to built Yuyue.app
YUYUE_MAC_APP=""
# Android: output of `adb devices` (e.g. emulator-5554)
ANDROID_DEVICE_ID=""
# iOS: WebDriverAgent port (default 8100)
IOS_WDA_PORT="8100"
# Web reader preview URL (served by `yuyue-cli site` or `reader/scripts/serve.mjs`)
YUYUE_WEB_URL="http://127.0.0.1:8787/book/beiying/s/0.html"
