# Copy to `.env` (never commit `.env`).
# Note: `run-midscene.mjs` also automatically falls back to `tests/midscene/.env` if present!
# Midscene uses a Vision-Language Model (VLM) to perceive UI screenshots and drive actions.

# --- Option A: ModelScope API-Inference (recommended, China direct access) ---
MIDSCENE_MODEL_BASE_URL="https://api-inference.modelscope.cn/v1"
MIDSCENE_MODEL_API_KEY="your-modelscope-access-token"
MIDSCENE_MODEL_NAME="Qwen/Qwen3.5-35B-A3B"
MIDSCENE_MODEL_FAMILY="qwen3.5"

# --- Option B: Qwen-VL via DashScope (OpenAI-compatible) ---
# MIDSCENE_MODEL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# MIDSCENE_MODEL_API_KEY="sk-your-dashscope-key"
# MIDSCENE_MODEL_NAME="qwen3-vl-plus"
# MIDSCENE_MODEL_FAMILY="qwen3-vl"

# --- Option C: Local Ollama / vLLM (0 cost) ---
# MIDSCENE_MODEL_BASE_URL="http://127.0.0.1:11434/v1"
# MIDSCENE_MODEL_API_KEY="ollama"
# MIDSCENE_MODEL_NAME="qwen3-vl:8b"
# MIDSCENE_MODEL_FAMILY="qwen3-vl"

# --- Platform targets (optional overrides) ---
# Windows: path to built WinUI executable (auto-detected Release -> Debug if omitted)
YUYUE_WIN_EXE=""
# Desktop displayId for Windows/macOS (optional; omit for primary monitor)
MIDSCENE_DISPLAY_ID=""
# macOS: path to built Debug Yuyue.app (auto-detected apple/build/dd & Xcode DerivedData if omitted)
YUYUE_MAC_APP=""
# Android: output of `adb devices` (auto-selects first online device if omitted)
ANDROID_DEVICE_ID=""
ANDROID_ADB_PATH=""
YUYUE_ANDROID_APK=""
# iOS: WebDriverAgent endpoint (default http://127.0.0.1:8100; or set IOS_WDA_BASE_URL)
IOS_WDA_HOST="127.0.0.1"
IOS_WDA_PORT="8100"
IOS_WDA_BASE_URL=""
# Web reader demo server (auto-starts reader/scripts/serve.mjs on port 8787 if omitted)
YUYUE_WEB_PORT="8787"
YUYUE_WEB_URL=""
