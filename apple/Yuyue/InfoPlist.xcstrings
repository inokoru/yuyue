    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "When a computer's browser sends books to Yuyue, it connects to this device over your Wi‑Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "电脑浏览器给语阅传书、从你的 Mac 传有声书录音时，要经过你的 Wi‑Fi 连到这台设备。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "克隆声音",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To clone a voice, Yuyue records a short passage of you reading. The recording stays on this device, and is only sent to your own ElevenLabs account if you explicitly enable it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "克隆声音时，录一小段你念书的声音。录音留在这台设备上，只在你主动开启 ElevenLabs 时才传到你自己的账号。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "有声书和电子书对齐时，在这台设备上把录音转成文字，找出每句念在哪里。录音不会离开这台设备。"
          }
        }
      }
    },
    "有声书" : {
