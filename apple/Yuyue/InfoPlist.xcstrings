    "Kindle 电子书" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kindle Book"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a computer's browser sends books to Yuyue, or your Mac transfers audiobook recordings, it connects to this device over your Wi‑Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑浏览器给语阅传书、从你的 Mac 传有声书录音时，要经过你的 Wi‑Fi 连到这台设备。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "克隆声音与播客语音插话",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuyue uses the microphone to record a short passage when cloning a voice, or to transcribe your spoken question during podcast Q&A. Recordings stay on this device and are only sent to your own ElevenLabs account if you explicitly enable it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "克隆声音或播客语音插话提问时使用麦克风。录音留在这台设备上，只在你主动开启 ElevenLabs 时才传到你自己的账号。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuyue transcribes speech on this device to align audiobooks with e-books, transcribe local podcast audio, and capture voice questions. Your audio never leaves this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有声书对齐、播客本地转写和语音插话时，在这台设备上把声音转成文字。录音不会离开这台设备。"
          }
        }
      }
    },
    "有声书" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audiobook"
          }
        }
      }
    },
