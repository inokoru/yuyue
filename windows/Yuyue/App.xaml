                    <SolidColorBrush x:Key="YYSidebarSelectedBrush" Color="#122A2B2E" />
                    <SolidColorBrush x:Key="YYSidebarHoverBrush" Color="#0C2A2B2E" />
                    <!-- ShelfDesk.field: 侧栏搜索框 -->
                    <SolidColorBrush x:Key="YYSidebarFieldBrush" Color="#0D000000" />
                    <!-- CoverFace.stone: 无图封面的暖石色 -->
                    <SolidColorBrush x:Key="YYStoneBrush" Color="#EBE6DD" />
                    <!-- readingBand: 在读横带 -->
