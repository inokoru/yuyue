<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Yuyue.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 与 macOS (ShelfDesk + design/tokens.json) 精确对齐 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- ShelfDesk.fill: 桌面比纸页深一阶 -->
                    <SolidColorBrush x:Key="YYDeskBrush" Color="#EAE8E3" />
                    <!-- YYColor.bg: 浮起的暖白纸页 -->
                    <SolidColorBrush x:Key="YYBgBrush" Color="#F8F5F0" />
                    <!-- YYColor.card: 纸页上的纯白卡片（在读卡、设置块） -->
                    <SolidColorBrush x:Key="YYCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="YYInsetBrush" Color="#EFEEEB" />
                    <SolidColorBrush x:Key="YYLineBrush" Color="#E7E5E1" />
                    <SolidColorBrush x:Key="YYPaperBorderBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="YYText1Brush" Color="#2A2B2E" />
                    <SolidColorBrush x:Key="YYText2Brush" Color="#6E6B68" />
                    <SolidColorBrush x:Key="YYText3Brush" Color="#8A8682" />
                    <SolidColorBrush x:Key="YYPillBrush" Color="#FBFAF7" />
                    <SolidColorBrush x:Key="YYPillLineBrush" Color="#2950412D" />
                    <SolidColorBrush x:Key="YYAccentBrush" Color="#8A653F" />
                    <SolidColorBrush x:Key="YYAccentSoftBrush" Color="#F2E7DB" />
                    <SolidColorBrush x:Key="YYAccentEdgeBrush" Color="#D4B396" />
                    <SolidColorBrush x:Key="YYDangerBrush" Color="#C2473A" />
                    <SolidColorBrush x:Key="YYOkBrush" Color="#3E9B6A" />
                    <!-- ShelfDesk.on: 浅暖灰透明洗色，不是白卡片 -->
                    <SolidColorBrush x:Key="YYSidebarSelectedBrush" Color="#122A2B2E" />
                    <SolidColorBrush x:Key="YYSidebarHoverBrush" Color="#0C2A2B2E" />
                    <!-- ShelfDesk.field: 侧栏搜索框 -->
                    <SolidColorBrush x:Key="YYSidebarFieldBrush" Color="#0D000000" />
                    <!-- CoverFace.stone: 无图封面的暖石色 -->
                    <SolidColorBrush x:Key="YYStoneBrush" Color="#EBE6DD" />
                    <!-- readingBand: 在读横带 -->
                    <SolidColorBrush x:Key="YYReadingBandBrush" Color="#082A2B2E" />
                    <SolidColorBrush x:Key="YYReadingBandLineBrush" Color="#0C2A2B2E" />
                    <!-- 设置侧栏底色（对齐 MacSettingsSide.header） -->
                    <SolidColorBrush x:Key="YYSettingsSideBrush" Color="#FBFAF9" />
                    <!-- 覆盖 WinUI 3 默认系统蓝与深色开关边框：完全对齐 macOS 圆润无框暖灰开关 -->
                    <Color x:Key="SystemAccentColor">#8A653F</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8A653F" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#7A5835" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6B4C2D" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#8A653F" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#7A5835" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#6B4C2D" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#8A653F" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#7A5835" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#6B4C2D" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#8A653F" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#7A5835" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6B4C2D" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#DDDAD4" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#D2CEC7" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#C7C2BA" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#E4E2DC" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="YYDeskBrush" Color="#0C0C0D" />
                    <SolidColorBrush x:Key="YYBgBrush" Color="#1A1613" />
                    <SolidColorBrush x:Key="YYCardBrush" Color="#1B1C1E" />
                    <SolidColorBrush x:Key="YYInsetBrush" Color="#26272A" />
                    <SolidColorBrush x:Key="YYLineBrush" Color="#2C2D30" />
                    <SolidColorBrush x:Key="YYPaperBorderBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="YYText1Brush" Color="#EDEDEE" />
                    <SolidColorBrush x:Key="YYText2Brush" Color="#9A9895" />
                    <SolidColorBrush x:Key="YYText3Brush" Color="#8E8C89" />
                    <SolidColorBrush x:Key="YYPillBrush" Color="#2C2D30" />
                    <SolidColorBrush x:Key="YYPillLineBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="YYAccentBrush" Color="#A0754F" />
                    <SolidColorBrush x:Key="YYAccentSoftBrush" Color="#2D2722" />
                    <SolidColorBrush x:Key="YYAccentEdgeBrush" Color="#5A4A3A" />
                    <SolidColorBrush x:Key="YYDangerBrush" Color="#E5806F" />
                    <SolidColorBrush x:Key="YYOkBrush" Color="#5DBB88" />
                    <SolidColorBrush x:Key="YYSidebarSelectedBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="YYSidebarHoverBrush" Color="#0CFFFFFF" />
                    <SolidColorBrush x:Key="YYSidebarFieldBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="YYStoneBrush" Color="#2C2824" />
                    <SolidColorBrush x:Key="YYReadingBandBrush" Color="#06FFFFFF" />
                    <SolidColorBrush x:Key="YYReadingBandLineBrush" Color="#0CFFFFFF" />
                    <SolidColorBrush x:Key="YYSettingsSideBrush" Color="#161719" />
                    <Color x:Key="SystemAccentColor">#A0754F</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#A0754F" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B0845D" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8E6542" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#A0754F" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#B0845D" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#8E6542" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#A0754F" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#B0845D" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#8E6542" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#A0754F" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#B0845D" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#8E6542" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#38393D" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#434449" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#4D4E54" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#EDEDEE" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#2C2D30" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#8E8C89" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 根级默认覆写，确保任何未显式指定 ThemeDictionary 的 WinUI 控件也不落回系统蓝 -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8A653F" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#7A5835" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6B4C2D" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#8A653F" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#7A5835" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#6B4C2D" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#8A653F" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#7A5835" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#6B4C2D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#8A653F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#7A5835" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6B4C2D" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#DDDAD4" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#D2CEC7" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#C7C2BA" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />

            <!-- 白胶囊 + 细边按钮（对照 Mac YYPillChrome，高 28） -->
            <Style x:Key="YYPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource YYPillBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource YYText1Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YYPillLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <!-- 主操作暖纸洗色胶囊按钮 -->
            <Style x:Key="YYPrimaryPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource YYAccentSoftBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource YYAccentBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YYAccentEdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <!-- 透明图标按钮 -->
            <Style x:Key="YYIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource YYText2Brush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <!-- 侧栏行按钮（对照 Mac SidebarRow：高度 28，圆角 7，字号 12） -->
            <Style x:Key="YYSidebarItemStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource YYText1Brush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Height" Value="29" />
                <Setter Property="MinHeight" Value="29" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <!-- 侧栏分组标题按钮（折叠用，仿 Mac SidebarGroupTitle） -->
            <Style x:Key="YYSidebarGroupStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource YYText3Brush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="8,10,8,4" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
