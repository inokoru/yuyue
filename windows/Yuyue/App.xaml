            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8A653F" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#7A5835" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6B4C2D" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#E4E1DB" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#DDDAD3" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#D5D1C9" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#8A653F" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#7A5835" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#6B4C2D" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#F7F5F1" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#CCC8C0" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#E2DFDA" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#CFCBC4" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8A653F" />
            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1.5</Thickness>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#8A653F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#7A5835" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6B4C2D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#E3E0DA" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FFFFFF" />
