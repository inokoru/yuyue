            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#0C2A2B2E" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#152A2B2E" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#1E2A2B2E" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#E4E2DC" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#84726D67" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#96726D67" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#96726D67" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#322A2B2E" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#B85A5652" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#DC383634" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FF2A2B2E" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#786E6B68" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#8A653F" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#7A5835" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#6B4C2D" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#8A653F" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#7A5835" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#6B4C2D" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />

            <!-- 原生 WinUI 3 Fluent 2 CheckBox（始终使用暖色强调，避免暗色模式回落系统蓝） -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{ThemeResource YYText1Brush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="7,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CombinedStates">
                                        <VisualState x:Name="UncheckedNormal" />
                                        <VisualState x:Name="UncheckedPointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="UncheckedHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="UncheckedPressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="UncheckedPress" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.03" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="UncheckedDisabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedNormal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CheckedBox" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="UncheckedBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CheckedBox" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="UncheckedBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="CheckedHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CheckedBox" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="UncheckedBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="CheckedPress" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.03" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CheckedBox" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="UncheckedBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminateNormal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="IndeterminateBox" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="UncheckedBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="IndeterminateBox" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="UncheckedBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="CheckedHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="IndeterminateBox" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="UncheckedBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="CheckedPress" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.03" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminateDisabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="IndeterminateBox" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="UncheckedBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid Width="17" Height="17" VerticalAlignment="Center">
                                    <Border
                                        x:Name="UncheckedBox"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource YYText3Brush}"
                                        BorderThickness="1.35" />
                                    <Border
                                        x:Name="UncheckedHover"
                                        CornerRadius="4"
                                        Background="{ThemeResource YYSubtleHoverBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                    <Border
                                        x:Name="UncheckedPress"
                                        CornerRadius="4"
                                        Background="{ThemeResource YYSubtlePressBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                    <Border
                                        x:Name="CheckedBox"
                                        CornerRadius="4"
                                        Background="{ThemeResource YYAccentBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                        <Path
                                            Data="M 1.5,5.0 L 4.2,7.8 L 9.6,2.0"
                                            Width="11"
                                            Height="10"
                                            Stroke="White"
                                            StrokeThickness="1.75"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <Border
                                        x:Name="IndeterminateBox"
                                        CornerRadius="4"
                                        Background="{ThemeResource YYAccentBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                        <Border Width="8" Height="1.8" CornerRadius="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border
                                        x:Name="CheckedHover"
                                        CornerRadius="4"
                                        Background="{ThemeResource YYAccentHoverOverlayBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                    <Border
                                        x:Name="CheckedPress"
                                        CornerRadius="4"
                                        Background="{ThemeResource YYAccentPressOverlayBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                </Grid>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Grid.Column="1"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    TextWrapping="Wrap"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 原生 WinUI 3 Fluent 2 ToggleSwitch（44px 紧贴卡片右缘且保留完整呼吸空间） -->
            <Style TargetType="ToggleSwitch">
                <Setter Property="Width" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 原生 WinUI 3 Fluent 2 Slider -->
            <Style TargetType="Slider">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 默认单行输入框垂直内边距微调（改善中文行高垂直居中） -->
            <Thickness x:Key="TextControlThemePadding">10,6,10,5</Thickness>

            <!-- 原生 WinUI 3 Fluent 2 ComboBox 统一高度与垂直居中 -->
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <!-- 严格像素级垂直居中的单行 Fluent 2 TextBox（彻底解决 WinUI 3 默认 PlaceholderText 偏上缺陷） -->
            <Style x:Key="YYSingleLineTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource YYText1Brush}" />
                <Setter Property="Background" Value="{ThemeResource YYCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderThickness">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="1,1,1,2" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="BorderElement"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Margin="{TemplateBinding Padding}"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Hidden"
                                    IsTabStop="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock
                                    x:Name="PlaceholderTextContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Text="{TemplateBinding PlaceholderText}"
                                    Foreground="{ThemeResource YYText3Brush}"
                                    FontSize="{TemplateBinding FontSize}"
                                    TextTrimming="CharacterEllipsis"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 带一键清空 × 按钮的单行搜索/筛选输入框（严格垂直居中，非空即显示清空按钮） -->
            <Style x:Key="YYSearchTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource YYText1Brush}" />
                <Setter Property="Background" Value="{ThemeResource YYCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderThickness">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="1,1,1,2" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="BorderElement"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Hidden"
                                    IsTabStop="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock
                                    x:Name="PlaceholderTextContentPresenter"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Text="{TemplateBinding PlaceholderText}"
                                    Foreground="{ThemeResource YYText3Brush}"
                                    FontSize="{TemplateBinding FontSize}"
                                    TextTrimming="CharacterEllipsis"
                                    IsHitTestVisible="False" />
                                <Button
                                    x:Name="YYClearButton"
                                    Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    MinWidth="22"
                                    MinHeight="22"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="Collapsed"
                                    IsTabStop="False"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    ToolTipService.ToolTip="清空">
                                    <Path
                                        Data="M 1.5,1.5 L 7.5,7.5 M 7.5,1.5 L 1.5,7.5"
                                        Width="9"
                                        Height="9"
                                        Stroke="{ThemeResource YYText3Brush}"
                                        StrokeThickness="1.35"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round" />
                                </Button>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 严格垂直居中的单行 Fluent 2 PasswordBox -->
            <Style x:Key="YYCompactPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,6,10,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Fluent 2 浮层卡片 FlyoutPresenter（10px 圆角） -->
            <Style x:Key="YYFloatFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource YYCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YYLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>

            <!-- 全局隐式 Button 模板：保留自定义背景/边框/前景色，以柔和状态层呈现悬停与按压，彻底杜绝 WinUI 默认白块覆盖 -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource YYText1Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="11,5,11,6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.03" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="SurfaceBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="{ThemeResource YYSubtleHoverBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                                <Border
                                    x:Name="PressOverlay"
                                    Background="{ThemeResource YYSubtlePressBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Margin="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent 2 轻量文字操作按钮 -->
            <Style x:Key="YYTextActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource YYText1Brush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07" />
                                            </Storyboard>
                                        </VisualState>
