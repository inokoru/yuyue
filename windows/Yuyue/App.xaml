                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B0845D" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8E6542" />
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#323337" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3C3D42" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#45464B" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#A0754F" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#B0845D" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#8E6542" />
