                <ResourceDictionary x:Key="Light">
                    <!-- ShelfDesk.fill: 桌面比纸页深一阶 -->
                    <SolidColorBrush x:Key="YYDeskBrush" Color="#EAE8E3" />
                    <!-- YYColor.bg: 浮起的暖白纸页 -->
                    <SolidColorBrush x:Key="YYBgBrush" Color="#F8F5F0" />
