                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#EDEDEE" />
                    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#F2F2F3" />
                    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#44464C" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#333438" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#46474C" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#A0754F" />
