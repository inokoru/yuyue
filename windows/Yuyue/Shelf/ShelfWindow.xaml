<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yuyue.Shelf.ShelfWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="语阅">

    <!-- 1:1 对照 macOS MacShelfView：暖灰书桌 (#EAE8E3) + 桌面顶部窗控条（不切纸页圆角）+ 完整浮起的暖白纸页 (#F8F5F0) -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource YYDeskBrush}"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        DragLeave="RootGrid_DragLeave"
        Drop="RootGrid_Drop"
        PreviewKeyDown="RootGrid_PreviewKeyDown"
        KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 阴影接收面（铺满整个书桌底层，让纸页与封面投出柔和阴影） -->
        <Grid x:Name="DeskShadowReceiver" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="Transparent" />

        <!-- 顶部 32px 书桌窗头拖动区：右上角 Windows [ — □ × ] 窗控键完整落在暖灰书桌条内，零遮挡下方纸页按钮 -->
        <Grid x:Name="TopDragBar" Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent" />

        <!-- 左侧栏：无卡片，直接写在书桌上 -->
        <Grid x:Name="SidebarPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Padding="10,36,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 搜索 · 问 框 -->
            <Button
                x:Name="QuickSearchTrigger"
                Grid.Row="0"
                Margin="0,2,0,8"
                Height="30"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="9,0"
                CornerRadius="9"
                BorderThickness="0"
                Background="{ThemeResource YYSidebarFieldBrush}"
                UseSystemFocusVisuals="False"
                Click="QuickSearchTrigger_Click">
                <Grid ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="SearchIconHost" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="搜索 · 问" FontSize="12" Foreground="{ThemeResource YYText2Brush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Ctrl+K" FontSize="10.5" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- 侧栏分组（资料库 / 笔记 / 合集，对照 Mac sidebarRows） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="0,0,0,8">
                <StackPanel Spacing="1">
                    <Button
                        x:Name="GroupHeaderLibrary"
                        Style="{StaticResource YYSidebarGroupStyle}"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="展开或收起资料库分组"
                        Tag="library"
                        Click="ToggleGroup_Click"
                        PointerEntered="GroupHeader_PointerEntered"
                        PointerExited="GroupHeader_PointerExited">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="资料库" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="GroupChevronLibrary" Grid.Column="1" VerticalAlignment="Center" Opacity="0" />
                        </Grid>
                    </Button>
                    <StackPanel x:Name="GroupLibrary" Spacing="1">
                        <Button x:Name="NavAll" Style="{StaticResource YYSidebarItemStyle}" Tag="all" Click="NavItem_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconAll" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="书" VerticalAlignment="Center" />
                                <TextBlock x:Name="CountAll" Grid.Column="2" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavProgress" Style="{StaticResource YYSidebarItemStyle}" Tag="progress" Click="NavItem_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconProgress" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="进度" VerticalAlignment="Center" />
                                <TextBlock x:Name="CountProgress" Grid.Column="2" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavPodcasts" Style="{StaticResource YYSidebarItemStyle}" Tag="podcasts" Click="NavItem_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconPodcasts" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="播客" VerticalAlignment="Center" />
                                <TextBlock x:Name="CountPodcasts" Grid.Column="2" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavAudio" Style="{StaticResource YYSidebarItemStyle}" Tag="audio" Click="NavItem_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconAudio" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="有声" VerticalAlignment="Center" />
                                <TextBlock x:Name="CountAudio" Grid.Column="2" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Button
                        x:Name="GroupHeaderNotes"
                        Style="{StaticResource YYSidebarGroupStyle}"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="展开或收起笔记分组"
                        Tag="notes"
                        Click="ToggleGroup_Click"
                        PointerEntered="GroupHeader_PointerEntered"
                        PointerExited="GroupHeader_PointerExited">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="笔记" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="GroupChevronNotes" Grid.Column="1" VerticalAlignment="Center" Opacity="0" />
                        </Grid>
                    </Button>
                    <StackPanel x:Name="GroupNotes" Spacing="1">
                        <Button x:Name="NavNotes" Style="{StaticResource YYSidebarItemStyle}" Tag="notes" Click="NavItem_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconNotes" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="笔记" VerticalAlignment="Center" />
                                <TextBlock x:Name="CountNotes" Grid.Column="2" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavWords" Style="{StaticResource YYSidebarItemStyle}" Tag="words" Click="NavItem_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconWords" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="生词本" VerticalAlignment="Center" />
                                <TextBlock x:Name="CountWords" Grid.Column="2" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Button
                        x:Name="GroupHeaderCollections"
                        Style="{StaticResource YYSidebarGroupStyle}"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="展开或收起合集分组"
                        Tag="collections"
                        Click="ToggleGroup_Click"
                        PointerEntered="GroupHeader_PointerEntered"
                        PointerExited="GroupHeader_PointerExited">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="合集" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="GroupChevronCollections" Grid.Column="1" VerticalAlignment="Center" Opacity="0" />
                        </Grid>
                    </Button>
                    <StackPanel x:Name="GroupCollections" Spacing="1">
                        <Button
                            x:Name="NavCollections"
                            Style="{StaticResource YYSidebarItemStyle}"
                            Tag="collections"
                            AllowDrop="True"
                            DragOver="NavCollections_DragOver"
                            DragLeave="NavCollections_DragLeave"
                            Drop="NavCollections_Drop"
                            Click="NavItem_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconCollections" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="合集" VerticalAlignment="Center" />
                                <TextBlock x:Name="CountCollections" Grid.Column="2" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <StackPanel x:Name="CollectionsStack" Spacing="1" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 侧栏底部（对照 Mac sidebarFoot：同步状态 + 设置 + 反馈） -->
            <Grid Grid.Row="2" Padding="2,4,0,0" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SyncFooterBtn"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="6"
                    UseSystemFocusVisuals="False"
                    Click="SyncStatus_Click">
                    <Grid ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="SyncDot" Width="6" Height="6" Fill="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SyncStatusText" Grid.Column="1" Text="尚未开启同步" FontSize="11" Foreground="{ThemeResource YYText2Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="SyncDevicesText" Grid.Column="2" Visibility="Collapsed" FontSize="10" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button
                    x:Name="SettingsFootBtn"
                    Grid.Column="1"
                    Style="{StaticResource YYIconButtonStyle}"
                    ToolTipService.ToolTip="设置 (Ctrl+,)"
                    Click="OpenSettings_Click" />

                <Button
                    x:Name="FeedbackFootBtn"
                    Grid.Column="2"
                    Style="{StaticResource YYIconButtonStyle}"
                    ToolTipService.ToolTip="反馈"
                    Click="Feedback_Click" />
            </Grid>
        </Grid>

        <!-- 右侧浮起的暖白纸页（完整四圆角 + ThemeShadow 柔和投影，位于 32px 书桌窗控条下方，彻底避开右上角 Windows 窗控键） -->
        <Border
            x:Name="PaperSheet"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,8,8"
            CornerRadius="12"
            Background="{ThemeResource YYBgBrush}"
            BorderBrush="{ThemeResource YYPaperBorderBrush}"
            BorderThickness="0.5">
            <Grid x:Name="PaperInnerGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 纸页标题行：左 侧栏开关 + 动态自定义区（播客托盘 / 返回按钮）或 22px 标题 + 副标题，右 动态页头操作区 -->
                <Grid Grid.Row="0" Padding="18,14,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="SidebarToggleBtn"
                        Grid.Column="0"
                        Style="{StaticResource YYIconButtonStyle}"
                        ToolTipService.ToolTip="显示或隐藏侧栏 (Ctrl+Alt+S)"
                        VerticalAlignment="Center"
                        Click="ToggleSidebar_Click" />

                    <StackPanel
                        x:Name="HeaderLeftCustomHost"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="8,0,8,0"
                        VerticalAlignment="Center" />

                    <TextBlock
                        x:Name="ViewTitleText"
                        Grid.Column="2"
                        Text="书"
                        FontSize="22"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Margin="8,0,12,0"
                        Foreground="{ThemeResource YYText1Brush}" />

                    <TextBlock
                        x:Name="ViewSubtitleText"
                        Grid.Column="3"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="0,3,12,0"
                        Foreground="{ThemeResource YYText2Brush}" />

                    <StackPanel x:Name="HeaderRightHost" Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="ImportBtn"
                            Style="{StaticResource YYPillButtonStyle}"
                            ToolTipService.ToolTip="导入书 (Ctrl+O)：EPUB、PDF、MOBI、AZW3、TXT 或有声书；右键可无线传书"
                            Click="ImportButton_Click">
                            <Button.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="选择本地书籍或音频导入…" Click="ImportButton_Click" />
                                    <MenuFlyoutItem Text="导入有声书文件夹 / 压缩包…" Click="ImportAudioFolder_Click" />
                                    <MenuFlyoutItem Text="从 OPDS / WebDAV 远程书库导入…" Click="RemoteLibrary_Click" />
                                    <MenuFlyoutItem Text="局域网无线传书 (Wi-Fi)…" Click="WifiTransfer_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="恢复 .yuyue 书库快照…" Click="RestoreSnapshotMenu_Click" />
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <ContentPresenter x:Name="ImportPlusIcon" VerticalAlignment="Center" />
                                <TextBlock Text="导入" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 主体内容区 -->
                <Grid Grid.Row="1">
                    <!-- 1. 书架主视图 -->
                    <ScrollViewer x:Name="ShelfScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ShelfContentStack" Padding="0,0,0,48">
                            <!-- 在读横带（默认单行横排，绝不折成半空第二行，1:1 对齐 01-shelf.png） -->
                            <Border
                                x:Name="ReadingBand"
                                Visibility="Collapsed"
                                Background="{ThemeResource YYReadingBandBrush}"
                                BorderBrush="{ThemeResource YYReadingBandLineBrush}"
                                BorderThickness="0,1,0,1"
                                Padding="22,14,28,20"
                                Margin="0,0,0,20">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="在读" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource YYText1Brush}" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="ReadingBandCount" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                                            <Button
                                                x:Name="ReadingExpandBtn"
                                                Visibility="Collapsed"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource YYText2Brush}"
                                                UseSystemFocusVisuals="False"
                                                Click="ReadingExpand_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="ReadingCardsHost" />
                                </StackPanel>
                            </Border>

                            <!-- 书籍网格区 -->
                            <StackPanel x:Name="GridSection" Padding="22,4,28,0">
                                <Grid x:Name="GridHeaderRow" Margin="2,0,0,14">
                                    <TextBlock x:Name="GridCountText" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText1Brush}" VerticalAlignment="Center" />
                                    <Button
                                        x:Name="SortButton"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,2"
                                        UseSystemFocusVisuals="False">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="SortLabelText" Text="最近读过" FontSize="11.5" Foreground="{ThemeResource YYText2Brush}" />
                                            <ContentPresenter x:Name="SortChevronIcon" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <ToggleMenuFlyoutItem x:Name="SortItemRecent" Text="最近读过" Tag="recent" Click="SortItem_Click" />
                                                <ToggleMenuFlyoutItem x:Name="SortItemAdded" Text="加入时间" Tag="added" Click="SortItem_Click" />
                                                <ToggleMenuFlyoutItem x:Name="SortItemTitle" Text="书名" Tag="title" Click="SortItem_Click" />
                                                <ToggleMenuFlyoutItem x:Name="SortItemAuthor" Text="作者" Tag="author" Click="SortItem_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <ItemsRepeater x:Name="BooksRepeater">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            x:Name="BooksGridLayout"
                                            MinItemWidth="100"
                                            MinItemHeight="198"
                                            MinColumnSpacing="18"
                                            MinRowSpacing="22"
                                            ItemsStretch="None" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>

                                <!-- 空书架 / 有声空态（1:1 MacShelfView.swift:1104-1130） -->
                                <StackPanel
                                    x:Name="EmptyStatePanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,150,0,0"
                                    Spacing="10">
                                    <ContentPresenter x:Name="EmptyIconHost" HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyTitleText"
                                        Text="书架是空的，把 EPUB、PDF、MOBI、TXT 拖进窗口就能开始读"
                                        FontSize="12.5"
                                        Foreground="{ThemeResource YYText2Brush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptySubtitleText"
                                        Visibility="Collapsed"
                                        FontSize="12"
                                        MaxWidth="340"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Foreground="{ThemeResource YYText2Brush}"
                                        HorizontalAlignment="Center" />
                                    <Button
                                        x:Name="EmptyActionBtn"
                                        Visibility="Collapsed"
                                        Style="{StaticResource YYPillButtonStyle}"
                                        Height="28"
                                        MinHeight="28"
                                        Margin="0,4,0,0"
                                        Padding="12,0"
                                        HorizontalAlignment="Center"
                                        Click="ImportButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. 进度 / 播客 / 笔记 / 生词本 / 合集子页 -->
                    <ScrollViewer x:Name="SubPageScroll" Visibility="Collapsed" Padding="22,4,28,40" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SubPageStack" Spacing="12" />
                    </ScrollViewer>

                    <!-- 子页底部常驻浮坞（访谈书页 46px 迷你播放条） -->
                    <ContentControl
                        x:Name="SubPageBottomDockHost"
                        Visibility="Collapsed"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="22,0,28,14" />

                    <!-- 顶部撤销/提示横幅（对齐 UndoToast.swift e42fcb6：自适应单行/双行白瓷胶囊 + 胶囊动作按钮 + 独立关闭按钮） -->
                    <Border
                        x:Name="ToastBanner"
                        Visibility="Collapsed"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Height="Auto"
                        MinHeight="38"
                        MaxWidth="460"
                        Padding="12,8"
                        CornerRadius="19"
                        Background="{ThemeResource YYCardBrush}"
                        BorderBrush="{ThemeResource YYLineBrush}"
                        BorderThickness="1"
                        PointerEntered="ToastBanner_PointerEntered"
                        PointerExited="ToastBanner_PointerExited">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border x:Name="ToastDisc" Width="17" Height="17" CornerRadius="8.5" Background="#2DBE60" VerticalAlignment="Center">
                                <ContentPresenter x:Name="ToastCheckIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ToastText" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource YYText1Brush}" TextWrapping="Wrap" MaxWidth="310" />
                                <TextBlock x:Name="ToastDetailText" Visibility="Collapsed" FontSize="11.5" Foreground="{ThemeResource YYText2Brush}" TextWrapping="Wrap" MaxWidth="310" />
                            </StackPanel>
                            <Button
                                x:Name="ToastUndoButton"
                                Visibility="Collapsed"
                                Height="26"
                                MinHeight="26"
                                Padding="10,0"
                                CornerRadius="13"
                                Background="{ThemeResource YYInsetBrush}"
                                Foreground="{ThemeResource YYText1Brush}"
                                FontSize="11.5"
                                FontWeight="Medium"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="撤销 (Ctrl+Z)"
                                Click="ToastUndo_Click" />
                            <Button
                                x:Name="ToastCloseButton"
                                Width="22"
                                Height="22"
                                MinWidth="22"
                                MinHeight="22"
                                Padding="0"
                                CornerRadius="11"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Click="ToastClose_Click" />
                        </StackPanel>
                    </Border>

                    <!-- 拖入文件提示蒙层（对齐 MacImport.swift MacDropHint，穿透命中保证合集卡片接收拖拽不闪断） -->
                    <Border
                        x:Name="DropOverlay"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Background="{ThemeResource YYBgBrush}"
                        Padding="22"
                        CornerRadius="12">
                        <Border
                            x:Name="DropOverlayInner"
                            IsHitTestVisible="False"
                            CornerRadius="18"
                            BorderBrush="{ThemeResource YYAccentBrush}"
                            BorderThickness="1.5"
                            Background="{ThemeResource YYAccentSoftBrush}">
                            <StackPanel IsHitTestVisible="False" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border IsHitTestVisible="False" Width="60" Height="60" CornerRadius="30" Background="{ThemeResource YYAccentSoftBrush}" HorizontalAlignment="Center">
                                    <ContentPresenter x:Name="DropArrowIcon" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="DropOverlayTitleText" IsHitTestVisible="False" Text="松开即可导入书库" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="DropOverlaySubtitleText" IsHitTestVisible="False" Text="书名、作者和封面从文件里读出来，之后都能改" FontSize="12.5" Foreground="{ThemeResource YYText2Brush}" HorizontalAlignment="Center" />
                                <Border IsHitTestVisible="False" CornerRadius="14" Background="{ThemeResource YYCardBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="1" Padding="16,12,20,12" HorizontalAlignment="Center">
                                    <StackPanel IsHitTestVisible="False" Spacing="8">
                                        <StackPanel IsHitTestVisible="False" Orientation="Horizontal" Spacing="6">
                                            <TextBlock IsHitTestVisible="False" Text="书" Width="46" TextAlignment="Right" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" VerticalAlignment="Center" />
                                            <Border IsHitTestVisible="False" CornerRadius="5" Background="{ThemeResource YYInsetBrush}" Padding="7,3"><TextBlock IsHitTestVisible="False" Text="EPUB" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" /></Border>
                                            <Border IsHitTestVisible="False" CornerRadius="5" Background="{ThemeResource YYInsetBrush}" Padding="7,3"><TextBlock IsHitTestVisible="False" Text="TXT" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" /></Border>
                                            <Border IsHitTestVisible="False" CornerRadius="5" Background="{ThemeResource YYInsetBrush}" Padding="7,3"><TextBlock IsHitTestVisible="False" Text="PDF" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" /></Border>
                                            <Border IsHitTestVisible="False" CornerRadius="5" Background="{ThemeResource YYInsetBrush}" Padding="7,3"><TextBlock IsHitTestVisible="False" Text="MOBI" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" /></Border>
                                            <Border IsHitTestVisible="False" CornerRadius="5" Background="{ThemeResource YYInsetBrush}" Padding="7,3"><TextBlock IsHitTestVisible="False" Text="AZW3" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" /></Border>
                                        </StackPanel>
                                        <StackPanel IsHitTestVisible="False" Orientation="Horizontal" Spacing="6">
                                            <TextBlock IsHitTestVisible="False" Text="有声书" Width="46" TextAlignment="Right" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" VerticalAlignment="Center" />
                                            <Border IsHitTestVisible="False" CornerRadius="5" Background="{ThemeResource YYInsetBrush}" Padding="7,3"><TextBlock IsHitTestVisible="False" Text="M4B" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" /></Border>
                                            <Border IsHitTestVisible="False" CornerRadius="5" Background="{ThemeResource YYInsetBrush}" Padding="7,3"><TextBlock IsHitTestVisible="False" Text="MP3" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" /></Border>
                                            <Border IsHitTestVisible="False" CornerRadius="5" Background="{ThemeResource YYInsetBrush}" Padding="7,3"><TextBlock IsHitTestVisible="False" Text="ZIP" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" /></Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock IsHitTestVisible="False" Text="✓ 同一个文件只导入一次：按内容认，改过名字也认得出来" FontSize="11.5" Foreground="{ThemeResource YYOkBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 非模态右下角实时导入队列浮卡（1:1 MacImport.swift MacImportCard） -->
        <Border
            x:Name="ImportQueueCard"
            Grid.Row="1"
            Grid.Column="1"
            Visibility="Collapsed"
            Width="320"
            CornerRadius="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,22,22"
            Background="{ThemeResource YYCardBrush}"
            BorderBrush="{ThemeResource YYLineBrush}"
            BorderThickness="1"
            PointerEntered="ImportQueueCard_PointerEntered"
            PointerExited="ImportQueueCard_PointerExited" />

        <!-- 搜索 · 问 悬浮框（Ctrl+K，对齐 QuickSearch.swift：640px 宽 + 52px 搜索头 + 三组结果 + 36px 快捷键底栏） -->
        <Grid
            x:Name="QuickSearchOverlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Visibility="Collapsed"
            Background="#32000000"
            PointerPressed="QuickSearchBackdrop_Pressed">
            <Border
                x:Name="QuickSearchCard"
                Width="640"
                MaxHeight="520"
                VerticalAlignment="Top"
                Margin="0,68,0,0"
                CornerRadius="16"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="0.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="0.5" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0.5" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="QuickSearchLeadIcon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBox
                            x:Name="QuickSearchBox"
                            Grid.Column="1"
                            PlaceholderText="搜书名、原文、笔记，或者问书伴"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Padding="4,6"
                            TextChanged="QuickSearchBox_TextChanged"
                            KeyDown="QuickSearchBox_KeyDown" />
                        <Button
                            x:Name="QuickSearchCloseBtn"
                            Grid.Column="2"
                            Height="24"
                            MinHeight="24"
                            MinWidth="34"
                            Padding="7,0"
                            CornerRadius="5"
                            Background="{ThemeResource YYInsetBrush}"
                            BorderBrush="{ThemeResource YYLineBrush}"
                            BorderThickness="0.5"
                            VerticalAlignment="Center"
                            UseSystemFocusVisuals="False"
                            AutomationProperties.Name="关闭面板"
                            ToolTipService.ToolTip="关闭 (Esc)"
                            Click="QuickSearchClose_Click">
                            <TextBlock Text="esc" FontSize="10.5" Foreground="{ThemeResource YYText2Brush}" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{ThemeResource YYLineBrush}" />

                    <ScrollViewer Grid.Row="2" MaxHeight="410" Padding="10,8" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="QuickSearchResults" Spacing="3" />
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="{ThemeResource YYLineBrush}" />

                    <Grid Grid.Row="4" Padding="14,0" Background="{ThemeResource YYCardBrush}" CornerRadius="0,0,16,16">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border CornerRadius="4" Background="{ThemeResource YYInsetBrush}" Padding="5,1"><TextBlock Text="↑" FontSize="10" Foreground="{ThemeResource YYText2Brush}" /></Border>
                            <Border CornerRadius="4" Background="{ThemeResource YYInsetBrush}" Padding="5,1"><TextBlock Text="↓" FontSize="10" Foreground="{ThemeResource YYText2Brush}" /></Border>
                            <TextBlock Text="选择" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border CornerRadius="4" Background="{ThemeResource YYInsetBrush}" Padding="5,1"><TextBlock Text="↵" FontSize="10" Foreground="{ThemeResource YYText2Brush}" /></Border>
                            <TextBlock Text="打开" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border CornerRadius="4" Background="{ThemeResource YYInsetBrush}" Padding="5,1"><TextBlock Text="Ctrl+↵" FontSize="10" Foreground="{ThemeResource YYText2Brush}" /></Border>
                            <TextBlock Text="问书伴" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="QuickSearchScopeText" FontSize="11" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
