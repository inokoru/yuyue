<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Yuyue</RootNamespace>
    <AssemblyName>Yuyue</AssemblyName>
    <Version>0.1.3</Version>
    <AssemblyVersion>0.1.3.6</AssemblyVersion>
    <FileVersion>0.1.3.6</FileVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Optional local/CI build-time feedback relay config (gitignored windows/feedback.props or -p:YuyueFeedbackTopic=...) -->
  <Import Project="..\feedback.props" Condition="Exists('..\feedback.props')" />
  <ItemGroup Condition="'$(YuyueFeedbackTopic)' != ''">
    <AssemblyMetadata Include="YuyueFeedbackTopic" Value="$(YuyueFeedbackTopic)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

  <!-- Native Rust core DLL copied beside Yuyue.exe -->
  <ItemGroup>
    <Content Include="Native\x64\yuyue_core.dll" Condition="'$(Platform)' != 'ARM64' and Exists('Native\x64\yuyue_core.dll')">
      <Link>yuyue_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\arm64\yuyue_core.dll" Condition="'$(Platform)' == 'ARM64' and Exists('Native\arm64\yuyue_core.dll')">
      <Link>yuyue_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- TypeScript reader bundle served at https://yuyue.local/app/ -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" Condition="Exists('Assets\AppIcon.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AppIcon.png" Condition="Exists('Assets\AppIcon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AppIcons\**\*.*" Condition="Exists('Assets\AppIcons')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Brands\**\*.*" Condition="Exists('Assets\Brands')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Reader\**\*.*" Condition="Exists('Assets\Reader')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\L10n\en.json" Condition="Exists('Assets\L10n\en.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\android\app\src\main\assets-dict\ecdict.tsv" Condition="Exists('..\..\android\app\src\main\assets-dict\ecdict.tsv')">
      <Link>Assets\Dict\ecdict.tsv</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\shared\wifi-page.html" Condition="Exists('..\..\shared\wifi-page.html')">
      <Link>Assets\Shared\wifi-page.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\CHANGELOG.md" Condition="Exists('..\..\CHANGELOG.md')">
      <Link>Assets\Shared\CHANGELOG.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yuyue.Tests" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
