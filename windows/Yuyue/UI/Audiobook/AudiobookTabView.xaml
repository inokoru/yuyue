<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yuyue.UI.Audiobook.AudiobookTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 原生有声书标签页：40px 工具栏（一键弹置顶迷你窗）+ 居中暖纸大封面播控舞台 + 右停靠章节/书签/配对栏 -->
    <Grid x:Name="RootGrid" Background="{ThemeResource YYCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Row 0: 40px 顶部工具栏 -->
        <Grid
            Grid.Row="0"
            Padding="14,0,12,0"
            ColumnSpacing="12"
            Background="{ThemeResource YYCardBrush}"
            BorderBrush="{ThemeResource YYLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="TopAudioIcon" Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock x:Name="TopTitleText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource YYText1Brush}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button
                    x:Name="PipBtn"
                    Style="{StaticResource YYFluentButtonStyle}"
                    Height="26"
                    MinHeight="26"
                    Padding="10,0"
                    FontSize="11.5"
                    Content="弹出置顶迷你窗"
                    ToolTipService.ToolTip="弹出置顶 Acrylic 迷你播放器，边办公边听书"
                    Click="OpenMiniPlayer_Click" />
                <Button
                    x:Name="BookmarkBtn"
                    Style="{StaticResource YYFluentButtonStyle}"
                    Height="26"
                    MinHeight="26"
                    Padding="10,0"
                    FontSize="11.5"
                    Content="+ 音频书签 (B)"
                    Click="AddBookmark_Click" />
                <Button
                    x:Name="DetachBtn"
                    Style="{StaticResource YYToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="撕出到独立窗口"
                    Click="Detach_Click" />
            </StackPanel>
        </Grid>

        <!-- Row 1: 主播放舞台 + 右侧章节/书签/配对停靠栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="324" />
            </Grid.ColumnDefinitions>

            <!-- 左侧居中大封面与五键播控台 -->
            <Grid Grid.Column="0">
                <StackPanel Width="420" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16">
                    <Border
                        x:Name="CoverFrame"
                        Width="236"
                        Height="236"
                        CornerRadius="12"
                        Background="{ThemeResource YYInsetBrush}"
                        BorderBrush="{ThemeResource YYLineBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                        <Grid>
                            <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                            <ContentPresenter x:Name="CoverFallbackIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="ChapterTitleText" FontSize="18.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText1Brush}" TextAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BookBylineText" FontSize="12" Foreground="{ThemeResource YYText2Brush}" TextAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 章节进度条 -->
                    <StackPanel Spacing="4">
                        <Slider
                            x:Name="ChapterSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="ChapterSlider_ValueChanged" />
                        <Grid>
                            <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="11" Foreground="{ThemeResource YYText3Brush}" />
                            <TextBlock x:Name="RemainingText" Text="" FontSize="11" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DurationText" Text="00:00" FontSize="11" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- 5 枚播控键：倍速 · -15s · 播放/暂停 · +30s · 睡眠定时 -->
                    <Grid Padding="20,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="RateBtn" Grid.Column="0" Style="{StaticResource YYTextActionButtonStyle}" Content="1.0×" FontSize="12.5" HorizontalAlignment="Center" Click="Rate_Click" />
                        <Button x:Name="RewindBtn" Grid.Column="1" Style="{StaticResource YYToolbarIconButtonStyle}" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" ToolTipService.ToolTip="后退 15 秒 (←)" Click="Rewind15_Click" />
                        <Button x:Name="PlayPauseBtn" Grid.Column="2" Style="{StaticResource YYFluentAccentButtonStyle}" Width="58" Height="58" CornerRadius="29" Padding="0" HorizontalAlignment="Center" ToolTipService.ToolTip="播放 / 暂停 (空格)" Click="PlayPause_Click" />
                        <Button x:Name="ForwardBtn" Grid.Column="3" Style="{StaticResource YYToolbarIconButtonStyle}" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" ToolTipService.ToolTip="前进 30 秒 (→)" Click="Forward30_Click" />
                        <Button x:Name="SleepBtn" Grid.Column="4" Style="{StaticResource YYToolbarIconButtonStyle}" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" ToolTipService.ToolTip="睡眠定时" />
                    </Grid>

                    <!-- 响度均衡与音量增益控制 -->
                    <Grid Padding="20,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="响度增益" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                        <Slider
                            x:Name="GainSlider"
                            Grid.Column="1"
                            Minimum="35"
                            Maximum="100"
                            Value="100"
                            StepFrequency="5"
                            IsThumbToolTipEnabled="False"
                            VerticalAlignment="Center"
                            ValueChanged="GainSlider_ValueChanged" />
                        <TextBlock x:Name="GainValueText" Grid.Column="2" Text="100%" FontSize="11" Width="36" TextAlignment="Right" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="SleepStatusText" FontSize="11.5" Foreground="{ThemeResource YYAccentBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 睡前返回浮卡（底部居中） -->
                <ContentPresenter
                    x:Name="SleepReturnHost"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16" />
            </Grid>

            <!-- 右侧停靠栏：章节 / 书签 / 配对与对齐 -->
            <Grid Grid.Column="1" Background="{ThemeResource YYSettingsSideBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="RightTabsBar" Grid.Row="0" Orientation="Horizontal" Spacing="4" Padding="12,10" />
                <ScrollViewer Grid.Row="1" Padding="12,0,12,16">
                    <StackPanel x:Name="RightPaneStack" Spacing="6" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Row 2: 28px 底栏 -->
        <Border Grid.Row="2" Padding="14,0" Background="{ThemeResource YYCardBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLeftText" Grid.Column="0" Text="有声书" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="空格播放/暂停 · ← 后退15秒 · → 前进30秒 · B 加书签" FontSize="11" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
