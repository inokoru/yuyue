<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yuyue.UI.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 原生设置标签页：左 214px Warm Mica 导航（与书库严格等宽） + 全局设置搜索 + 中无断层单角画布 + 右实时样张预览 -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：全局设置搜索 + 11 项分类导航（返回书库已融合至顶部 40px 标题栏左槽） -->
        <Grid Grid.Column="0" Padding="8,4,8,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 全局设置搜索框 -->
            <TextBox
                x:Name="GlobalSearchBox"
                Grid.Row="0"
                Style="{StaticResource YYSingleLineTextBoxStyle}"
                Margin="0,0,0,10"
                FontSize="12"
                PlaceholderText="搜索设置（托盘、空格、Mica）"
                TextChanged="GlobalSearchBox_TextChanged" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="NavStack" Spacing="2" Padding="0,0,0,16" />
            </ScrollViewer>
        </Grid>

        <!-- 中栏：左上单角 10px 圆角主设置画布（与书库画布几何 100% 一致） -->
        <Border
            Grid.Column="1"
            Background="{ThemeResource YYCanvasBrush}"
            BorderBrush="{ThemeResource YYLineBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 干净留白页头（无生硬 T 字错位横线） -->
                <StackPanel Grid.Row="0" Padding="28,22,28,12" Spacing="4">
                    <TextBlock x:Name="PageTitleText" Text="通用与操控" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource YYText1Brush}" />
                    <TextBlock x:Name="PageSubtitleText" Text="窗口标签、鼠键习惯、文件关联与启动方式" FontSize="12.5" Foreground="{ThemeResource YYText2Brush}" />
                </StackPanel>

                <ScrollViewer x:Name="MainScroller" Grid.Row="1" Padding="28,8,28,56" VerticalScrollBarVisibility="Auto" SizeChanged="MainScroller_SizeChanged">
                    <StackPanel x:Name="PageBodyStack" Spacing="10" Width="760" HorizontalAlignment="Left" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右栏：按需展开的实时阅读纸张 / 排版样张检查器 -->
        <Border
            x:Name="InspectorBorder"
            Grid.Column="2"
            Visibility="Collapsed"
            Background="{ThemeResource YYSettingsSideBrush}"
            BorderBrush="{ThemeResource YYLineBrush}"
            BorderThickness="1,1,0,0"
            Padding="20,24,20,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="InspectorStack" Spacing="14" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
