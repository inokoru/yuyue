                                                    <Button x:Name="IndentAutoBtn" Grid.Column="0" Tag="auto" Content="跟书" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="Indent_Click" />
                                                    <Button x:Name="IndentOnBtn" Grid.Column="1" Tag="on" Content="缩进" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="Indent_Click" />
                                                    <Button x:Name="IndentOffBtn" Grid.Column="2" Tag="off" Content="不缩" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="Indent_Click" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Grid>
                                            <TextBlock Text="两端对齐" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource YYText1Brush}" />
                                            <Border HorizontalAlignment="Right" Width="156" CornerRadius="9" Background="{ThemeResource YYInsetBrush}" Padding="2">
                                                <Grid ColumnSpacing="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="JustifyAutoBtn" Grid.Column="0" Tag="auto" Content="跟书" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="Justify_Click" />
                                                    <Button x:Name="JustifyOnBtn" Grid.Column="1" Tag="on" Content="对齐" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="Justify_Click" />
                                                    <Button x:Name="JustifyOffBtn" Grid.Column="2" Tag="off" Content="靠左" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="Justify_Click" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Border CornerRadius="10" Background="{ThemeResource YYInsetBrush}" Padding="10,2">
                                            <Grid Height="32">
                                                <TextBlock Text="中文标点挤压" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource YYText1Brush}" />
                                                <ToggleSwitch x:Name="CompressToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Toggled="CompressToggle_Toggled" />
                                            </Grid>
                                        </Border>

                                        <Grid x:Name="ScriptRow">
                                            <TextBlock Text="简繁" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource YYText1Brush}" />
                                            <Border HorizontalAlignment="Right" Width="156" CornerRadius="9" Background="{ThemeResource YYInsetBrush}" Padding="2">
                                                <Grid ColumnSpacing="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="ScriptOrigBtn" Grid.Column="0" Tag="orig" Content="原样" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="BookScript_Click" />
                                                    <Button x:Name="ScriptSimpBtn" Grid.Column="1" Tag="simp" Content="简体" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="BookScript_Click" />
                                                    <Button x:Name="ScriptTradBtn" Grid.Column="2" Tag="trad" Content="繁體" Height="24" Padding="0" FontSize="11" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="BookScript_Click" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0,4" UseSystemFocusVisuals="False" Click="ReplaceRules_Click">
                                            <Grid>
                                                <TextBlock Text="替换规则" FontSize="12" Foreground="{ThemeResource YYText1Brush}" />
                                                <TextBlock Text="去广告、改读音 ›" FontSize="11" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Button>

                                        <Button x:Name="TxtLayoutBtn" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0,4" UseSystemFocusVisuals="False" Click="TxtLayout_Click">
                                            <Grid>
                                                <TextBlock Text="编码和目录" FontSize="12" Foreground="{ThemeResource YYText1Brush}" />
                                                <TextBlock Text="乱码、章节不对 ›" FontSize="11" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Button>

                                        <TextBlock Text="页边距随窗口宽度自动调节，保持舒适行宽。" FontSize="11" Foreground="{ThemeResource YYText3Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="TranslateBtn" Visibility="Collapsed" Width="30" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="每段下面跟着译文；关掉只剩原文，双击一句只翻这一句" Click="ToggleTranslate_Click" />
                    <Button x:Name="CompanionBtn" Width="30" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="书伴" Tag="companion" Click="TogglePanel_Click" />
                    <Button x:Name="CastBtn" Width="30" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="人物" Tag="cast" Click="TogglePanel_Click" />
                    <Button x:Name="NotesBtn" Width="30" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="笔记 (Ctrl+Alt+N)" Tag="notes" Click="TogglePanel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
