<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yuyue.Reader.ReaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:Yuyue.Design"
    Title="读书">

    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown" KeyDown="RootGrid_KeyDown">
        <Grid x:Name="PageShadowReceiver" Background="Transparent" />

        <!-- 主体：书页占满全窗口高度（MacReaderView.swift:44-52），右侧浮动卡片面板 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="WebViewContainer" Grid.Column="0">
                <!-- 3 槽预加载 WebView2 容器（prev / current / next，TECH.md §3 & ReaderPager.swift） -->
                <Grid x:Name="WebViewSlotHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <!-- 启动瞬时上次书页截图缓存（TECH.md §3：首帧 ready 后无缝退场） -->
                <Image x:Name="LaunchSnapshotImage" Visibility="Collapsed" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />

                <!-- 上下滚动边界切章提示胶囊 (0c733b0: active paper colors, Margin="0,68,0,92", 松手进入 armed copy) -->
                <Border
                    x:Name="ScrollEdgeCue"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,68,0,92"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="0.5">
                    <TextBlock
                        x:Name="ScrollEdgeCueText"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{ThemeResource YYText2Brush}"
                        MaxWidth="320"
                        TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- 纯听模式覆盖层 (ListenOnlyCover, MacReaderCards.swift:1374-1398) -->
                <Grid x:Name="ListenOnlyCover" Visibility="Collapsed">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <ContentPresenter x:Name="ListenOnlyIconHost" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock x:Name="ListenOnlyTitleText" FontFamily="Georgia, SimSun, Songti SC" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="ListenOnlySubText" Text="纯听模式 · 已隐藏正文" FontSize="12" HorizontalAlignment="Center" Opacity="0.72" />
                        <Button
                            Style="{StaticResource YYPillButtonStyle}"
                            Content="显示原文"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Click="ExitListenOnly_Click" />
                    </StackPanel>
                </Grid>

                <!-- 沉浸模式底边悬停呼出听书胶囊/返回条感应区（仅全屏时启用命中测试，且置于浮卡与底部浮层下层以免拦截按钮点击） -->
                <Border
                    x:Name="ImmersiveBottomPeekZone"
                    Height="42"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    PointerEntered="ImmersiveBottomPeek_Entered"
                    PointerMoved="ImmersiveBottomPeek_Entered"
                    PointerExited="ImmersiveBottomPeek_Exited" />

                <!-- 选中浮卡菱形指针 (ReaderCards.swift diamond pointer) -->
                <Border
                    x:Name="SelectionCardPointer"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Width="11"
                    Height="11"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45" />
                    </Border.RenderTransform>
                </Border>

                <!-- 选中文字 / 编辑已有划线两行浮卡 (SelectionCard, 332px, ReaderCards.swift:52-222) -->
                <Border
                    x:Name="SelectionCard"
                    Visibility="Collapsed"
                    Width="332"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="10,8"
                    CornerRadius="14"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="7">
                        <!-- Row 0 (optional): 已有想法预览（右侧带 pencil 图标，点击直接编辑） -->
                        <StackPanel x:Name="SelectionNoteSection" Visibility="Collapsed" Spacing="6" PointerPressed="SelectionNotePreview_Pressed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource YYAccentBrush}" CornerRadius="1" />
                                <TextBlock x:Name="SelectionNotePreviewText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource YYText2Brush}" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                <ContentPresenter x:Name="SelectionNotePencilIcon" Grid.Column="2" VerticalAlignment="Center" Opacity="0.72" />
                            </Grid>
                            <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />
                        </StackPanel>

                        <!-- Row 1: 4 颜色圆点 (带 YYInsetBrush 1..4 键帽胶囊) + 实线/点线下划线 + 删除 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="SwatchYellowBtn" Tag="yellow" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="黄色划线 (1)" Click="MarkColor_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <Border x:Name="SwatchYellowRing" Width="22" Height="22" CornerRadius="11" Padding="1.5" BorderThickness="1.5" BorderBrush="Transparent">
                                            <Border CornerRadius="9" Background="#FBE7A0" BorderBrush="#22000000" BorderThickness="0.5" />
                                        </Border>
                                        <Border Width="16" Height="15" CornerRadius="4" Background="{ThemeResource YYInsetBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="1" FontSize="9" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwatchBlueBtn" Tag="blue" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="蓝色划线 (2)" Click="MarkColor_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <Border x:Name="SwatchBlueRing" Width="22" Height="22" CornerRadius="11" Padding="1.5" BorderThickness="1.5" BorderBrush="Transparent">
                                            <Border CornerRadius="9" Background="#CFE6F4" BorderBrush="#22000000" BorderThickness="0.5" />
                                        </Border>
                                        <Border Width="16" Height="15" CornerRadius="4" Background="{ThemeResource YYInsetBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="2" FontSize="9" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwatchPinkBtn" Tag="pink" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="粉色划线 (3)" Click="MarkColor_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <Border x:Name="SwatchPinkRing" Width="22" Height="22" CornerRadius="11" Padding="1.5" BorderThickness="1.5" BorderBrush="Transparent">
                                            <Border CornerRadius="9" Background="#F6C7C0" BorderBrush="#22000000" BorderThickness="0.5" />
                                        </Border>
                                        <Border Width="16" Height="15" CornerRadius="4" Background="{ThemeResource YYInsetBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="3" FontSize="9" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwatchWaveBtn" Tag="wave" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="波浪线 (4)" Click="MarkColor_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <Border x:Name="SwatchWaveRing" Width="22" Height="22" CornerRadius="11" Padding="1.5" BorderThickness="1.5" BorderBrush="Transparent">
                                            <Border x:Name="SwatchWaveFill" CornerRadius="9" Background="{ThemeResource YYInsetBrush}" BorderThickness="0">
                                                <TextBlock Text="~" FontSize="11.5" FontWeight="Bold" Foreground="#EF7F71" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                            </Border>
                                        </Border>
                                        <Border Width="16" Height="15" CornerRadius="4" Background="{ThemeResource YYInsetBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="4" FontSize="9" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="LineUnderlineBtn" Tag="underline" Width="32" Height="30" Padding="0" CornerRadius="8" Background="{ThemeResource YYInsetBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="1" UseSystemFocusVisuals="False" ToolTipService.ToolTip="实线下划线" Click="MarkColor_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="LineUnderlineAText" Text="A" FontSize="13" FontWeight="SemiBold" LineHeight="13" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                        <Border x:Name="LineUnderlineBar" Width="18" Height="2" CornerRadius="1" Background="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LineDottedBtn" Tag="dotted" Width="32" Height="30" Padding="0" CornerRadius="8" Background="{ThemeResource YYInsetBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="1" UseSystemFocusVisuals="False" ToolTipService.ToolTip="点线下划线" Click="MarkColor_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="LineDottedAText" Text="A" FontSize="13" FontWeight="SemiBold" LineHeight="13" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse x:Name="LineDot1" Width="2.6" Height="2.6" Fill="{ThemeResource YYText1Brush}" />
                                            <Ellipse x:Name="LineDot2" Width="2.6" Height="2.6" Fill="{ThemeResource YYText1Brush}" />
                                            <Ellipse x:Name="LineDot3" Width="2.6" Height="2.6" Fill="{ThemeResource YYText1Brush}" />
                                            <Ellipse x:Name="LineDot4" Width="2.6" Height="2.6" Fill="{ThemeResource YYText1Brush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteMarkCardBtn" Visibility="Collapsed" Width="28" Height="28" Padding="0" CornerRadius="8" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="删除划线" Click="DeleteOpenMark_Click">
                                    <ContentPresenter x:Name="SelDeleteIcon" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />

                        <!-- Row 2: 等宽竖排图标+文字按钮（想法 / 从这听 / [对准] / 问 / [翻译] / 复制） -->
                        <Grid x:Name="SelectionActionsGrid" ColumnSpacing="2">
                            <Button x:Name="SelThoughtBtn" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="AddThought_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelThoughtIcon" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ThoughtCardLabel" Text="想法" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SelSpeakBtn" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="SpeakFromSelection_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelSpeakIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="从这听" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SelPinBtn" Visibility="Collapsed" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="PinSelectionAudio_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelPinIcon" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="SelPinLabel" Text="" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SelAskBtn" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="AskSelection_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelAskIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="问" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource YYAccentBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SelTransBtn" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="TranslateSelection_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelTransIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="翻译" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SelCopyBtn" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="CopySelection_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelCopyIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="复制" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 查词浮卡 (WordCard, 346px, MacForeignCards.swift:7-109 — 无问书伴按钮，带可折叠更多释义与中性已加状态) -->
                <Border
                    x:Name="WordCard"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="346"
                    Padding="16,13"
                    CornerRadius="14"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="WordCardHeadword" FontFamily="Georgia" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource YYText1Brush}" />
                                <TextBlock x:Name="WordCardPhonetic" FontSize="11.5" Foreground="{ThemeResource YYText2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                            </StackPanel>
                            <Button x:Name="SpeakWordBtn" Width="28" Height="28" Padding="0" CornerRadius="14" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" HorizontalAlignment="Right" UseSystemFocusVisuals="False" ToolTipService.ToolTip="发音" Click="SpeakWord_Click" />
                        </Grid>
                        <TextBlock x:Name="WordCardMeaning" FontSize="13" Foreground="{ThemeResource YYText1Brush}" TextWrapping="Wrap" MaxLines="5" LineHeight="20" />
                        <WebView2 x:Name="DictEntryWebView" Visibility="Collapsed" Height="240" DefaultBackgroundColor="Transparent" />
                        <TextBlock x:Name="WordCardContext" Visibility="Collapsed" FontFamily="Georgia" FontStyle="Italic" FontSize="12" Foreground="{ThemeResource YYText3Brush}" TextWrapping="Wrap" MaxLines="2" />
                        <Border Height="0.5" Background="{ThemeResource YYLineBrush}" Margin="0,2,0,0" />
                        <Grid>
                            <TextBlock x:Name="WordCardSourceText" FontSize="10.5" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" MaxWidth="168" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button x:Name="FullDictEntryBtn" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Height="25" MinHeight="25" Padding="6,0" FontSize="11" Foreground="{ThemeResource YYText2Brush}" UseSystemFocusVisuals="False" Content="完整释义" Click="ToggleFullDictEntry_Click" />
                                <Button x:Name="AddVocabBtn" Style="{StaticResource YYPrimaryPillButtonStyle}" Content="+ 加入生词本" Height="26" MinHeight="26" Padding="11,0" FontSize="11" Click="AddVocab_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 单句翻译浮卡 (SentenceCard, 360px, MacForeignCards.swift:112-150 — 锚定双击坐标下方，无 ×，仅拷贝译文不关卡片) -->
                <Border
                    x:Name="SentenceCard"
                    Visibility="Collapsed"
                    Width="360"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="16,13"
                    CornerRadius="14"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SentenceOrigText" FontFamily="Georgia" FontSize="12.5" Foreground="{ThemeResource YYText2Brush}" TextWrapping="Wrap" MaxLines="4" LineHeight="19" />
                        <StackPanel x:Name="SentenceLoadingRow" Visibility="Collapsed" Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <ProgressRing IsActive="True" Width="14" Height="14" />
                            <TextBlock x:Name="SentenceLoadingText" Text="" FontSize="12.5" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="SentenceTransText" FontSize="14" Foreground="{ThemeResource YYText1Brush}" TextWrapping="Wrap" LineHeight="22" IsTextSelectionEnabled="True" />
                        <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />
                        <Grid>
                            <TextBlock x:Name="SentenceSourceText" Text="单句翻译 · 双击外文句子触发" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            <Button x:Name="CopySentenceTransBtn" Style="{StaticResource YYPillButtonStyle}" Content="拷贝" Height="25" MinHeight="25" FontSize="11.5" HorizontalAlignment="Right" Click="CopySentenceTrans_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 顶部紧凑状态提示横幅（文字版 TextVersionBanner / 书籍重整 MarksStale / 仅按章对齐有声书） -->
                <StackPanel
                    x:Name="TopInfoBannersStack"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,56,0,0"
                    Spacing="6">
                    <Border
                        x:Name="TextVersionBanner"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        MinHeight="30"
                        CornerRadius="10"
                        Padding="12,4,6,4"
                        Background="{ThemeResource YYCardBrush}"
                        BorderBrush="{ThemeResource YYLineBrush}"
                        BorderThickness="0.5">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TextVersionBannerText"
                                Text=""
                                FontSize="11.5"
                                Foreground="{ThemeResource YYText2Brush}"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="TextVersionPolishBtn"
                                Visibility="Collapsed"
                                Content=""
                                Height="24"
                                MinHeight="24"
                                Padding="9,0"
                                CornerRadius="8"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="{ThemeResource YYInsetBrush}"
                                Foreground="{ThemeResource YYText1Brush}"
                                BorderThickness="0"
                                UseSystemFocusVisuals="False"
                                Click="TextVersionPolish_Click" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="MarksStaleBanner"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        CornerRadius="12"
                        Padding="12,5,6,5"
                        Background="{ThemeResource YYCardBrush}"
                        BorderBrush="{ThemeResource YYLineBrush}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="这本书重新整理过，划线和书签在原来的位置"
                                FontSize="11.5"
                                Foreground="{ThemeResource YYText2Brush}"
                                VerticalAlignment="Center" />
                            <Button
                                Content="知道了"
                                Height="24"
                                MinHeight="24"
                                Padding="10,0"
                                CornerRadius="8"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="{ThemeResource YYInsetBrush}"
                                Foreground="{ThemeResource YYText1Brush}"
                                BorderThickness="0"
                                UseSystemFocusVisuals="False"
                                Click="AcknowledgeMarksBanner_Click" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="ChapterOnlyAudioBanner"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        CornerRadius="12"
                        Padding="12,6"
                        Background="{ThemeResource YYCardBrush}"
                        BorderBrush="{ThemeResource YYLineBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                        <TextBlock
                            Text="这本有声书只标到章，翻页不跟着声音走"
                            FontSize="11.5"
                            Foreground="{ThemeResource YYText2Brush}"
                            VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- 前情提要浮卡（锚定右上工具栏下方，ReaderRecap.swift:207-294） -->
                <ContentControl
                    x:Name="RecapCardHost"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,54,14,0" />

                <!-- 底部统一防重叠浮层栈 (MacReaderView.swift:605-710：ElsewhereCard / FootnoteCard / SleepReturn / ReturnPill / DoubtPill / ListenCapsule) -->
                <StackPanel
                    x:Name="BottomOverlayStack"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Spacing="10"
                    PointerEntered="ImmersiveBottomChild_Entered"
                    PointerExited="ImmersiveBottomChild_Exited">

                    <!-- 异地阅读进度提示卡片 (ElsewhereCard) -->
                    <ContentControl
                        x:Name="ElsewhereCardHost"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" />

                    <!-- 脚注浮卡 (FootnoteCard, 396px, ReaderFootnote.swift:17-81) -->
                    <Border
                        x:Name="FootnoteCard"
                        Visibility="Collapsed"
                        Width="396"
                        HorizontalAlignment="Center"
                        Padding="16,13"
                        CornerRadius="16"
                        Background="{ThemeResource YYCardBrush}"
                        BorderBrush="{ThemeResource YYLineBrush}"
                        BorderThickness="0.75">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,28,0">
                                    <TextBlock x:Name="FootnoteTitleText" Text="注释" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource YYAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FootnoteBeforeText" Text="" FontSize="11.5" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" MaxWidth="250" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="FootnoteCloseBtn" HorizontalAlignment="Right" Width="22" Height="22" Padding="0" CornerRadius="11" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="CloseFootnote_Click">
                                    <TextBlock Text="×" FontSize="13" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="FootnoteBodyText" FontFamily="SimSun" FontSize="14.5" Foreground="{ThemeResource YYText1Brush}" TextWrapping="Wrap" LineHeight="23" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                            <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />
                            <Grid>
                                <TextBlock x:Name="FootnoteMetaText" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                                <Button x:Name="FootnoteJumpBtn" Background="Transparent" BorderThickness="0" Padding="4,2" FontSize="11.5" Foreground="{ThemeResource YYText2Brush}" Content="到注释页 ›" HorizontalAlignment="Right" UseSystemFocusVisuals="False" Click="JumpFootnote_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 睡眠定时回到昨晚胶囊 (SleepReturnCard) -->
                    <ContentControl
                        x:Name="SleepReturnHost"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" />

                    <!-- 跳转后居中纸玻璃返回胶囊 (ReaderReturn.swift ReturnPill) -->
                    <Button
                        x:Name="ReturnPillBtn"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Height="32"
                        Padding="14,0"
                        CornerRadius="16"
                        Background="{ThemeResource YYCardBrush}"
                        BorderBrush="{ThemeResource YYLineBrush}"
                        BorderThickness="0.5"
                        UseSystemFocusVisuals="False"
                        Click="ReturnPill_Click">
                        <TextBlock x:Name="ReturnPillText" Text="↩ 回到刚才位置" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource YYText1Brush}" />
                    </Button>

                    <!-- TXT 分章提示胶囊 (DoubtPill) -->
                    <ContentControl
                        x:Name="DoubtPillHost"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" />

                    <!-- 原声跳过片头 / 伴听胶囊提示条 (capsuleAlert) -->
                    <Border
                        x:Name="CapsuleAlertBanner"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Height="30"
                        Padding="12,0,8,0"
                        CornerRadius="15"
                        Background="{ThemeResource YYCardBrush}"
                        BorderBrush="{ThemeResource YYLineBrush}"
                        BorderThickness="0.5">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="CapsuleAlertText" Text="" FontSize="11.5" Foreground="{ThemeResource YYText1Brush}" VerticalAlignment="Center" />
                            <Button
                                x:Name="CapsuleAlertActionBtn"
                                Visibility="Collapsed"
                                Content=""
                                Height="22"
                                MinHeight="22"
                                Padding="8,0"
                                CornerRadius="11"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                Foreground="{ThemeResource YYAccentBrush}"
                                BorderThickness="0"
                                UseSystemFocusVisuals="False"
                                Click="CapsuleAlertAction_Click" />
                        </StackPanel>
                    </Border>

                    <!-- 底部 360px 听书胶囊 + ListenCard 浮层 (1:1 MacReaderView.swift:605-688) -->
                    <Border
                        x:Name="ListenCapsule"
                        Visibility="Collapsed"
                        Width="360"
                        HorizontalAlignment="Center"
                        CornerRadius="23"
                        BorderThickness="0.5"
                        Padding="6,5">
                        <Grid>
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="CapsuleTocBtn"
                                    Grid.Column="0"
                                    Style="{StaticResource YYIconButtonStyle}"
                                    Width="32"
                                    Height="36"
                                    CornerRadius="18"
                                    Tag="toc"
                                    ToolTipService.ToolTip="目录"
                                    Click="TogglePanel_Click" />

                                <Button
                                    x:Name="CapsuleInfoBtn"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,0"
                                    Height="36"
                                    CornerRadius="12"
                                    UseSystemFocusVisuals="False"
                                    ToolTipService.ToolTip="听书：声音、速度、睡眠定时与伴听功能">
                                    <Button.Flyout>
                                        <Flyout x:Name="ListenCardFlyout" Placement="Top" Opened="ListenCardFlyout_Opened" Closed="ListenCardFlyout_Closed">
                                            <StackPanel x:Name="ListenCardHost" Width="432" Spacing="12" />
                                        </Flyout>
                                    </Button.Flyout>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CapsuleSentenceText" Text="第 1 / 1 句" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="CapsuleNoteText" Text="本章 1% · 还剩 1 分钟" FontSize="11" Opacity="0.76" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="CapsulePrevBtn" Grid.Column="2" Style="{StaticResource YYIconButtonStyle}" Width="30" Height="36" CornerRadius="15" ToolTipService.ToolTip="上一句 (Ctrl+[)" Click="SpeakPrev_Click" />
                                <Button x:Name="CapsulePlayBtn" Grid.Column="3" Width="36" Height="36" Padding="0" CornerRadius="18" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="朗读 / 暂停 (空格)" Click="ToggleListen_Click" />
                                <Button x:Name="CapsuleNextBtn" Grid.Column="4" Style="{StaticResource YYIconButtonStyle}" Width="30" Height="36" CornerRadius="15" ToolTipService.ToolTip="下一句 (Ctrl+])" Click="SpeakNext_Click" />
                            </Grid>

                            <!-- 胶囊内部底边 2px 进度细线 -->
                            <Grid Height="2" VerticalAlignment="Bottom" Margin="22,0,22,-4" IsHitTestVisible="False">
                                <Border x:Name="CapsuleProgressTrack" CornerRadius="1" Opacity="0.35" />
                                <Grid x:Name="CapsuleProgressGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CapsuleProgDoneCol" Width="0*" />
                                        <ColumnDefinition x:Name="CapsuleProgRestCol" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CapsuleProgressFill" CornerRadius="1" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 阅读器内非阻塞提示/撤销横幅 (UndoToast / ExtraNotice / SynthesisError) -->
                <Border
                    x:Name="ReaderToastBanner"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,66,0,0"
                    Height="36"
                    Padding="12,0,10,0"
                    CornerRadius="18"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="ReaderToastText" FontSize="12" Foreground="{ThemeResource YYText1Brush}" VerticalAlignment="Center" />
                        <Button
                            x:Name="ReaderToastActionBtn"
                            Visibility="Collapsed"
                            Height="24"
                            MinHeight="24"
                            Padding="10,0"
                            CornerRadius="12"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Background="{ThemeResource YYAccentSoftBrush}"
                            Foreground="{ThemeResource YYAccentBrush}"
                            BorderThickness="0"
                            UseSystemFocusVisuals="False"
                            Click="ReaderToastAction_Click" />
                    </StackPanel>
                </Border>

                <!-- 全屏沉浸底边 1.5px 进度细线 -->
                <Border
                    x:Name="ImmersiveProgressLine"
                    Visibility="Collapsed"
                    Height="1.5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Opacity="0.28"
                    IsHitTestVisible="False" />
            </Grid>

            <!-- 右侧浮动卡片面板（支持拖拽调节宽度，1:1 YYResizeHandle） -->
            <design:YYResizeHandle
                x:Name="SidePanelResizeHandle"
                Grid.Column="1"
                Margin="-6,58,0,16"
                Visibility="Collapsed" />
            <Border
                x:Name="SidePanelBorder"
                Grid.Column="1"
                Visibility="Collapsed"
                Margin="0,58,14,16"
                CornerRadius="16"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="1">
                <Grid>
                    <!-- 动态面板容器（目录 / 笔记 / 搜索 / 人物） -->
                    <Grid x:Name="DynamicSideHost" Visibility="Collapsed" Padding="14,14,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="SideHeaderHost" Grid.Row="0" Spacing="10" Margin="0,0,0,10" />
                        <ScrollViewer x:Name="SideBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="SideBodyStack" Spacing="0" Padding="0,0,0,12" />
                        </ScrollViewer>
                    </Grid>

                    <!-- 书伴对话面板 (1:1 MacReaderCards.swift & BookCompanion.swift) -->
                    <Grid x:Name="CompanionPanel" Visibility="Collapsed" Padding="14,14,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,10">
                            <!-- 头部：24x24 sparkle 徽标 + 书伴 + 书名 + 右侧 ··· 菜单 (2 项：清空对话、书伴设置…) -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" Background="{ThemeResource YYAccentSoftBrush}">
                                    <ContentPresenter x:Name="CompanionBadgeIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="书伴" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource YYText1Brush}" />
                                    <TextBlock x:Name="CompanionBookTitleText" FontSize="10.5" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Bottom" MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0,0,0,1" />
                                </StackPanel>
                                <Button x:Name="CompanionMoreBtn" Grid.Column="2" Width="26" Height="26" Padding="0" CornerRadius="13" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False">
                                    <ContentPresenter x:Name="CompanionMoreIcon" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="清空对话" Click="CompanionClear_Click" />
                                            <MenuFlyoutItem Text="书伴设置…" Click="CompanionSettings_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- 范围切换：仅限已读 | 全书范围 + 动态副标题 -->
                            <Border CornerRadius="9" Background="{ThemeResource YYInsetBrush}" Padding="2.5">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CompScopeReadBtn" Grid.Column="0" Tag="read" Content="仅限已读" Height="25" MinHeight="25" Padding="0" FontSize="11.5" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="CompanionScope_Click" />
                                    <Button x:Name="CompScopeWholeBtn" Grid.Column="1" Tag="whole" Content="全书范围" Height="25" MinHeight="25" Padding="0" FontSize="11.5" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="CompanionScope_Click" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CompanionScopeSubText" Text="截至当前页，不涉及后续情节" FontSize="10.5" Foreground="{ThemeResource YYText3Brush}" />
                            <Border Height="1" Background="{ThemeResource YYLineBrush}" />
                        </StackPanel>

                        <ScrollViewer x:Name="CompanionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CompanionMessages" Spacing="10" />
                        </ScrollViewer>

                        <!-- 底部：由 “ 触发的情境提问浮卡 ReadyLinesCard + 引用条 + / 指令浮层 + 纸色输入框 -->
                        <StackPanel Grid.Row="2" Spacing="8" Margin="0,8,0,0">
                            <Border x:Name="CompanionReadyLinesCard" Visibility="Collapsed" CornerRadius="12" Background="{ThemeResource YYCardBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="0.75" Padding="5,4">
                                <StackPanel x:Name="CompanionReadyLinesStack" Spacing="0" />
                            </Border>

                            <Border x:Name="CompanionQuoteBanner" Visibility="Collapsed" CornerRadius="8" Background="{ThemeResource YYInsetBrush}" Padding="8,6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource YYAccentBrush}" CornerRadius="1" />
                                    <TextBlock x:Name="CompanionQuoteText" Grid.Column="1" FontFamily="SimSun" FontSize="11.5" Foreground="{ThemeResource YYText2Brush}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="ClearCompanionQuoteBtn" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="2" MinWidth="18" MinHeight="18" UseSystemFocusVisuals="False" Click="ClearCompanionQuote_Click">
                                        <TextBlock Text="×" FontSize="11" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 11 个 / 快捷指令实时过滤弹窗 (1:1 BookCompanion.swift:311-435：顶部指令标题栏 + 24x24 图标块) -->
                            <Border x:Name="CompanionSlashPopup" Visibility="Collapsed" CornerRadius="12" Background="{ThemeResource YYCardBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="1" Padding="5,5,5,5">
                                <StackPanel Spacing="3">
                                    <Grid Margin="6,2,6,2">
                                        <TextBlock x:Name="CompanionSlashHeaderLeft" Text="" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="↑↓ 选择 · Tab 补全 · ↩ 执行" FontSize="10" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="0.5" Background="{ThemeResource YYLineBrush}" Margin="4,0,4,1" />
                                    <ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="CompanionSlashList" Spacing="1" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CompanionComposerBorder" CornerRadius="14" Background="{ThemeResource YYCardBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="0.75" Padding="10,8,8,7">
                                <StackPanel Spacing="6">
                                    <TextBox x:Name="CompanionInputBox" PlaceholderText="问这本书，或输入 / …" BorderThickness="0" Background="Transparent" FontSize="12.5" Padding="2,2" TextWrapping="Wrap" MaxHeight="84" TextChanged="CompanionInput_TextChanged" PreviewKeyDown="CompanionInput_PreviewKeyDown" KeyDown="CompanionInput_KeyDown" />
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button x:Name="CompanionPromptToggleBtn" Width="24" Height="24" Padding="0" CornerRadius="7" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="启发提问" Click="CompanionPromptToggle_Click">
                                                <TextBlock Text="“" FontFamily="Georgia" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource YYText2Brush}" Margin="0,2,0,-4" />
                                            </Button>
                                            <Button x:Name="CompanionSlashBtn" Width="24" Height="24" Padding="0" CornerRadius="7" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="快捷指令 (/)" Click="CompanionSlashBtn_Click">
                                                <TextBlock Text="/" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText2Brush}" />
                                            </Button>
                                            <Button x:Name="CompanionModelPillBtn" Height="24" MinHeight="24" Padding="8,0" CornerRadius="12" Background="{ThemeResource YYInsetBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="0.5" UseSystemFocusVisuals="False" ToolTipService.ToolTip="切换书伴模型" Click="CompanionChangeModel_Click">
                                                <Button.Flyout>
                                                    <Flyout x:Name="CompanionModelFlyout" Placement="TopEdgeAlignedLeft" Opened="CompanionModelFlyout_Opened">
                                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                            <StackPanel x:Name="CompanionModelFlyoutHost" Width="256" Spacing="2" />
                                                        </ScrollViewer>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CompanionModelPillText" Text="" FontSize="11" Foreground="{ThemeResource YYText2Brush}" MaxWidth="112" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="⇕" FontSize="9.5" Foreground="{ThemeResource YYText3Brush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="⇧↵ 换行" FontSize="10" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                                            <Button x:Name="CompanionSendBtn" Width="28" Height="28" Padding="0" CornerRadius="9" Background="{ThemeResource YYInsetBrush}" Foreground="{ThemeResource YYText2Brush}" BorderThickness="0" Opacity="0.32" UseSystemFocusVisuals="False" Click="CompanionSend_Click">
                                                <TextBlock Text="↑" FontSize="13" FontWeight="Bold" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 顶部悬浮透明工具栏 (56px, MacReaderView.swift:294-347, 435-512) -->
        <Grid x:Name="TopToolbar" Height="56" VerticalAlignment="Top" Padding="14,6,144,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 中：两行标题（搜索收起时显示，不参与命中测试） -->
            <StackPanel x:Name="TitleCenterStack" Grid.ColumnSpan="3" Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="BookTitleText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" FontSize="11" HorizontalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 中间空白拖动区（严格限制在 Column 1；搜索展开时切换为不覆盖搜索胶囊的左侧拖动区） -->
            <Border x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent" Margin="8,0" />

            <!-- 中：内联书内搜索胶囊（居中替换标题栏，左侧保留独立非重叠拖动区，MacReaderView.swift:318-322） -->
            <Grid x:Name="InlineSearchHostGrid" Grid.Column="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SearchSideDragRegion" Grid.Column="0" Background="Transparent" Margin="8,0" />
                <Border
                    x:Name="InlineSearchCapsule"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="32"
                    CornerRadius="16"
                    BorderThickness="1"
                    Padding="11,0,5,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ContentPresenter x:Name="InlineSearchIcon" VerticalAlignment="Center" />
                        <TextBox
                            x:Name="BookSearchBox"
                            Width="168"
                            BorderThickness="0"
                            Background="Transparent"
                            PlaceholderText="书内搜索"
                            FontSize="12.5"
                            Padding="2,3"
                            VerticalAlignment="Center"
                            TextChanged="BookSearchBox_TextChanged"
                            KeyDown="BookSearchBox_KeyDown" />
                        <TextBlock x:Name="SearchHitCountText" FontSize="11.5" FontWeight="SemiBold" Opacity="0.78" VerticalAlignment="Center" />
                        <Border Width="1" Height="14" Opacity="0.24" Background="Gray" Margin="2,0" />
                        <Button x:Name="SearchPrevBtn" Style="{StaticResource YYIconButtonStyle}" MinWidth="20" MinHeight="22" Padding="2" ToolTipService.ToolTip="上一处 (Shift+Ctrl+G)" Click="PrevHit_Click" />
                        <Button x:Name="SearchNextBtn" Style="{StaticResource YYIconButtonStyle}" MinWidth="20" MinHeight="22" Padding="2" ToolTipService.ToolTip="下一处 (Ctrl+G)" Click="NextHit_Click" />
                        <Button x:Name="SearchCloseCircleBtn" Width="22" Height="22" Padding="0" CornerRadius="11" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="收起 (Esc)" Click="CloseSearch_Click">
                            <ContentPresenter x:Name="SearchCloseXIcon" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 左：‹ 书架 / ‹ 播客 胶囊 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button
                    x:Name="BackToShelfBtn"
                    Height="30"
                    CornerRadius="15"
                    Padding="8,0,12,0"
                    BorderThickness="0.5"
                    UseSystemFocusVisuals="False"
                    ToolTipService.ToolTip="回到书架"
                    Click="BackToShelf_Click">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <ContentPresenter x:Name="BackChevronIcon" VerticalAlignment="Center" />
                        <TextBlock x:Name="BackToShelfLabel" Text="书架" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 右：前情提要按钮 + 统一毛玻璃工具胶囊 (MacReaderView.swift:462-512) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button
                    x:Name="RecapTopPillBtn"
                    Visibility="Collapsed"
                    Height="32"
                    CornerRadius="16"
                    Padding="11,0"
                    BorderThickness="0.5"
                    UseSystemFocusVisuals="False"
                    ToolTipService.ToolTip="查看前情提要（不剧透）"
                    Click="RecapTopPill_Click">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <ProgressRing x:Name="RecapTopSpinner" Visibility="Collapsed" IsActive="False" Width="12" Height="12" />
                        <ContentPresenter x:Name="RecapTopIconHost" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecapTopPillLabel" Text="前情提要" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecapTopPillDays" FontSize="11" Opacity="0.72" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border
                    x:Name="ToolCapsule"
                    VerticalAlignment="Center"
                    Height="32"
                    CornerRadius="16"
                    BorderThickness="0.5"
                    Padding="4,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="ListenBtn" Width="30" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="朗读 (空格)" Click="ToggleListen_Click" />
                        <Button x:Name="TocBtn" Width="30" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="目录、书签 (Ctrl+Alt+T)" Tag="toc" Click="TogglePanel_Click" />
                        <Button x:Name="SearchBtn" Width="30" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="书内搜索 (Ctrl+F)" Click="ToggleSearch_Click" />
                        <Button x:Name="TypesetBtn" Width="32" Height="26" Padding="0" CornerRadius="13" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="排版">
                            <TextBlock Text="Aa" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button.Flyout>
