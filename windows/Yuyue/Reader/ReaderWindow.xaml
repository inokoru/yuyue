<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yuyue.Reader.ReaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="读书">

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid x:Name="PageShadowReceiver" Background="Transparent" />

        <!-- 主体：书页占满全窗口高度（MacReaderView.swift:44-52），右侧浮动卡片面板 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="WebViewContainer" Grid.Column="0">
                <WebView2
                    x:Name="ReaderWebView"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    DefaultBackgroundColor="Transparent" />

                <!-- 纯听模式覆盖层 (ListenOnlyCover, MacReaderCards.swift:1374-1398) -->
                <Grid x:Name="ListenOnlyCover" Visibility="Collapsed">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <ContentPresenter x:Name="ListenOnlyIconHost" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock x:Name="ListenOnlyTitleText" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="ListenOnlySubText" Text="纯听模式 · 已隐藏正文" FontSize="12" HorizontalAlignment="Center" Opacity="0.72" />
                        <Button
                            Style="{StaticResource YYPillButtonStyle}"
                            Content="显示原文"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Click="ExitListenOnly_Click" />
                    </StackPanel>
                </Grid>

                <!-- 选中文字 / 编辑已有划线两行浮卡 (SelectionCard, 332px, ReaderCards.swift:52-222) -->
                <Border
                    x:Name="SelectionCard"
                    Visibility="Collapsed"
                    Width="332"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="10,8"
                    CornerRadius="14"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="7">
                        <!-- Row 0 (optional): 已有想法预览 -->
                        <StackPanel x:Name="SelectionNoteSection" Visibility="Collapsed" Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource YYAccentBrush}" CornerRadius="1" />
                                <TextBlock x:Name="SelectionNotePreviewText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource YYText2Brush}" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                            </Grid>
                            <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />
                        </StackPanel>

                        <!-- Row 1: 4 颜色圆点 (带 1..4 键帽) + 实线/点线下划线 + 删除 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Tag="yellow" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="黄色划线 (1)" Click="MarkColor_Click">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#FBE7A0" BorderBrush="#22000000" BorderThickness="0.5" />
                                        <TextBlock Text="1" FontSize="9" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="blue" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="蓝色划线 (2)" Click="MarkColor_Click">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#CFE6F4" BorderBrush="#22000000" BorderThickness="0.5" />
                                        <TextBlock Text="2" FontSize="9" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="pink" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="粉色划线 (3)" Click="MarkColor_Click">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#F6C7C0" BorderBrush="#22000000" BorderThickness="0.5" />
                                        <TextBlock Text="3" FontSize="9" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="wave" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="波浪线 (4)" Click="MarkColor_Click">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="Transparent" BorderBrush="#EF7F71" BorderThickness="1.5">
                                            <TextBlock Text="~" FontSize="11" FontWeight="Bold" Foreground="#EF7F71" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                        </Border>
                                        <TextBlock Text="4" FontSize="9" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Tag="underline" Width="28" Height="26" Padding="0" CornerRadius="6" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="实线下划线" Click="MarkColor_Click">
                                    <StackPanel Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="A" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <Border Width="12" Height="1.5" Background="{ThemeResource YYText1Brush}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="dotted" Width="28" Height="26" Padding="0" CornerRadius="6" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="点线下划线" Click="MarkColor_Click">
                                    <StackPanel Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="A" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="···" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteMarkCardBtn" Visibility="Collapsed" Width="28" Height="26" Padding="0" CornerRadius="6" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="删除划线" Click="DeleteOpenMark_Click">
                                    <ContentPresenter x:Name="SelDeleteIcon" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />

                        <!-- Row 2: 5 个等宽竖排图标+文字按钮（想法 / 从这读 / 问 / 翻译 / 复制） -->
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="AddThought_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelThoughtIcon" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ThoughtCardLabel" Text="想法" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="SpeakFromSelection_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelSpeakIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="从这读" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="AskSelection_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelAskIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="问" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource YYAccentBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="TranslateSelection_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelTransIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="翻译" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Height="41" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" Click="CopySelection_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="SelCopyIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="复制" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 查词浮卡 (WordCard, 346px, MacForeignCards.swift:7-109) -->
                <Border
                    x:Name="WordCard"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="346"
                    Padding="16,13"
                    CornerRadius="14"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="WordCardHeadword" FontFamily="Georgia" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource YYText1Brush}" />
                                <TextBlock x:Name="WordCardPhonetic" FontSize="11.5" Foreground="{ThemeResource YYText2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                            </StackPanel>
                            <Button x:Name="SpeakWordBtn" Width="28" Height="28" Padding="0" CornerRadius="14" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" HorizontalAlignment="Right" UseSystemFocusVisuals="False" ToolTipService.ToolTip="发音" Click="SpeakWord_Click" />
                        </Grid>
                        <TextBlock x:Name="WordCardMeaning" FontSize="13" Foreground="{ThemeResource YYText1Brush}" TextWrapping="Wrap" MaxLines="5" />
                        <WebView2 x:Name="DictEntryWebView" Visibility="Collapsed" Height="240" DefaultBackgroundColor="Transparent" />
                        <TextBlock x:Name="WordCardContext" Visibility="Collapsed" FontFamily="Georgia" FontStyle="Italic" FontSize="12" Foreground="{ThemeResource YYText3Brush}" TextWrapping="Wrap" MaxLines="2" />
                        <Border Height="0.5" Background="{ThemeResource YYLineBrush}" Margin="0,2,0,0" />
                        <Grid>
                            <TextBlock x:Name="WordCardSourceText" FontSize="10.5" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" MaxWidth="148" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                <Button x:Name="FullDictEntryBtn" Visibility="Collapsed" Style="{StaticResource YYPillButtonStyle}" Content="完整释义" Height="25" MinHeight="25" Padding="9,0" FontSize="11" Click="ToggleFullDictEntry_Click" />
                                <Button Style="{StaticResource YYPillButtonStyle}" Content="问书伴" Height="25" MinHeight="25" Padding="9,0" FontSize="11" Click="AskWord_Click" />
                                <Button x:Name="AddVocabBtn" Style="{StaticResource YYPrimaryPillButtonStyle}" Content="+ 加入生词本" Height="25" MinHeight="25" Padding="9,0" FontSize="11" Click="AddVocab_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 单句翻译浮卡 (SentenceCard, 360px, MacForeignCards.swift:112-150) -->
                <Border
                    x:Name="SentenceCard"
                    Visibility="Collapsed"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,78"
                    Padding="16,13"
                    CornerRadius="14"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Name="SentenceOrigText" FontFamily="Georgia" FontSize="13" Foreground="{ThemeResource YYText2Brush}" TextWrapping="Wrap" MaxLines="4" Margin="0,0,26,0" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" Padding="0" CornerRadius="12" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False" Click="CloseSentenceCard_Click">
                                <TextBlock Text="×" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SentenceTransText" FontSize="14" Foreground="{ThemeResource YYText1Brush}" TextWrapping="Wrap" LineHeight="22" />
                        <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />
                        <Grid>
                            <TextBlock x:Name="SentenceSourceText" Text="单句翻译 · 双击外文句子触发" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource YYPillButtonStyle}" Content="拷贝" Height="25" MinHeight="25" FontSize="11.5" HorizontalAlignment="Right" Click="CopySentenceTrans_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 脚注浮卡 (FootnoteCard, 396px, ReaderFootnote.swift:17-81) -->
                <Border
                    x:Name="FootnoteCard"
                    Visibility="Collapsed"
                    Width="396"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,76"
                    Padding="16,13"
                    CornerRadius="16"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Name="FootnoteTitleText" Text="注释" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource YYAccentBrush}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Width="24" Height="24" Padding="0" CornerRadius="12" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False" Click="CloseFootnote_Click">
                                <TextBlock Text="×" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="FootnoteBodyText" FontFamily="SimSun" FontSize="14.5" Foreground="{ThemeResource YYText1Brush}" TextWrapping="Wrap" LineHeight="23" MaxLines="8" />
                        <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />
                        <Grid>
                            <TextBlock x:Name="FootnoteMetaText" FontSize="11" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Center" />
                            <Button x:Name="FootnoteJumpBtn" Background="Transparent" BorderThickness="0" Padding="4,2" FontSize="11.5" Foreground="{ThemeResource YYAccentBrush}" Content="到注释页 ›" HorizontalAlignment="Right" Click="JumpFootnote_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 底部 360px 听书胶囊 + 448px ListenCard 浮层 (1:1 MacReaderView.swift:617-701 & MacReaderCards.swift:623-1067) -->
                <Border
                    x:Name="ListenCapsule"
                    Visibility="Collapsed"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    CornerRadius="24"
                    BorderThickness="1"
                    Padding="6,5">
                    <Grid>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：38x38 播放/暂停圆按钮 -->
                            <Button x:Name="CapsulePlayBtn" Grid.Column="0" Width="38" Height="38" Padding="0" CornerRadius="19" BorderThickness="0" UseSystemFocusVisuals="False" ToolTipService.ToolTip="朗读 / 暂停 (空格)" Click="ToggleListen_Click" />

                            <!-- 中：点击展开 448px ListenCard 浮层 -->
                            <Button
                                x:Name="CapsuleInfoBtn"
                                Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,0"
                                Height="38"
                                CornerRadius="12"
                                UseSystemFocusVisuals="False"
                                ToolTipService.ToolTip="听书：声音、速度、睡眠定时与伴听功能">
                                <Button.Flyout>
                                    <Flyout x:Name="ListenCardFlyout" Placement="Top" Opened="ListenCardFlyout_Opened">
                                        <StackPanel x:Name="ListenCardHost" Width="432" Spacing="12" />
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CapsuleSentenceText" Text="第 1 / 1 句" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CapsuleNoteText" Text="1% · 本章还剩 1 分钟" FontSize="11" Opacity="0.76" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>

                            <!-- 右：< 上一句 / > 下一句 -->
                            <Button x:Name="CapsulePrevBtn" Grid.Column="2" Style="{StaticResource YYIconButtonStyle}" Width="30" Height="32" ToolTipService.ToolTip="上一句 (Ctrl+[)" Click="SpeakPrev_Click" />
                            <Button x:Name="CapsuleNextBtn" Grid.Column="3" Style="{StaticResource YYIconButtonStyle}" Width="30" Height="32" ToolTipService.ToolTip="下一句 (Ctrl+])" Click="SpeakNext_Click" />
                        </Grid>

                        <!-- 胶囊内部底边 2px 进度细线 -->
                        <Grid Height="2" VerticalAlignment="Bottom" Margin="22,0,22,-2" IsHitTestVisible="False">
                            <Border x:Name="CapsuleProgressTrack" CornerRadius="1" Opacity="0.24" />
                            <Grid x:Name="CapsuleProgressGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CapsuleProgDoneCol" Width="0*" />
                                    <ColumnDefinition x:Name="CapsuleProgRestCol" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CapsuleProgressFill" CornerRadius="1" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 前情提要浮卡 (RecapCard, 1:1 ReaderRecap.swift:95-140) -->
                <ContentControl
                    x:Name="RecapCardHost"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,72,0,0" />

                <!-- 睡眠定时回到昨晚胶囊 (SleepReturnCard, 1:1 ReaderFlag.swift:260-294) -->
                <ContentControl
                    x:Name="SleepReturnHost"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,22" />

                <!-- 跳转后返回原位胶囊 (ReaderReturn) -->
                <Button
                    x:Name="ReturnPillBtn"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="20,0,0,20"
                    Height="30"
                    Padding="12,0"
                    CornerRadius="15"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1"
                    UseSystemFocusVisuals="False"
                    Click="ReturnPill_Click">
                    <TextBlock x:Name="ReturnPillText" Text="↩ 回到刚才位置" FontSize="11.5" Foreground="{ThemeResource YYText1Brush}" />
                </Button>

                <!-- 全屏沉浸底边 1.5px 进度细线 -->
                <Border
                    x:Name="ImmersiveProgressLine"
                    Visibility="Collapsed"
                    Height="1.5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Opacity="0.28"
                    IsHitTestVisible="False" />
            </Grid>

            <!-- 右侧浮动卡片面板（Companion 344px，其余 308px，顶部留出悬浮顶栏 58px） -->
            <Border
                x:Name="SidePanelBorder"
                Grid.Column="1"
                Visibility="Collapsed"
                Margin="0,58,14,16"
                CornerRadius="16"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="1">
                <Grid>
                    <!-- 动态面板容器（目录 / 笔记 / 搜索 / 人物） -->
                    <Grid x:Name="DynamicSideHost" Visibility="Collapsed" Padding="14,14,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="SideHeaderHost" Grid.Row="0" Spacing="10" Margin="0,0,0,10" />
                        <ScrollViewer x:Name="SideBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="SideBodyStack" Spacing="0" Padding="0,0,0,12" />
                        </ScrollViewer>
                    </Grid>

                    <!-- 书伴对话面板 (1:1 MacReaderCards.swift:1074-1368) -->
                    <Grid x:Name="CompanionPanel" Visibility="Collapsed" Padding="14,14,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,10">
                            <!-- 头部：24x24 sparkle 徽标 + 书伴 + 书名 + 右侧 ··· 菜单 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" Background="{ThemeResource YYAccentSoftBrush}">
                                    <ContentPresenter x:Name="CompanionBadgeIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="书伴" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource YYText1Brush}" />
                                    <TextBlock x:Name="CompanionBookTitleText" FontSize="10.5" Foreground="{ThemeResource YYText3Brush}" VerticalAlignment="Bottom" MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0,0,0,1" />
                                </StackPanel>
                                <Button Grid.Column="2" Width="26" Height="26" Padding="0" CornerRadius="13" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False">
                                    <ContentPresenter x:Name="CompanionMoreIcon" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="生成前情提要" Click="CompanionRecap_Click" />
                                            <MenuFlyoutItem Text="清空对话" Click="CompanionClear_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="书伴设置…" Click="CompanionSettings_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- 范围切换：仅限已读 | 全书范围 + 动态副标题 -->
                            <Border CornerRadius="9" Background="{ThemeResource YYInsetBrush}" Padding="2.5">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CompScopeReadBtn" Grid.Column="0" Tag="read" Content="仅限已读" Height="25" MinHeight="25" Padding="0" FontSize="11.5" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="CompanionScope_Click" />
                                    <Button x:Name="CompScopeWholeBtn" Grid.Column="1" Tag="whole" Content="全书范围" Height="25" MinHeight="25" Padding="0" FontSize="11.5" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="7" UseSystemFocusVisuals="False" Click="CompanionScope_Click" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CompanionScopeSubText" Text="截至当前页，不涉及后续情节" FontSize="10.5" Foreground="{ThemeResource YYText3Brush}" />
