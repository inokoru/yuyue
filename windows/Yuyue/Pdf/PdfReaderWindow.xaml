<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yuyue.Pdf.PdfReaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:Yuyue.Design"
    Title="PDF">

    <!-- 1:1 对齐 MacPdfView.swift：无底栏滑条、无左右大翻页箭头，全画布铺底 + 顶部悬浮四钮胶囊 + 底部常驻朗读胶囊 + 右侧 300px 浮卡 -->
    <Grid x:Name="RootGrid" Background="White" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid x:Name="PageShadowReceiver" Background="Transparent" />

        <!-- 主体：左 PDF 画布 + 右 300px 浮动面板栏 -->
        <Grid x:Name="MainColumnsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- PDF 页面画布（全高铺满，顶栏透明悬浮在上方） -->
            <Grid x:Name="CanvasHost" Grid.Column="0" Background="Transparent">
                <!-- 单页 / 双页跨页模式 -->
                <ScrollViewer
                    x:Name="PagedScroller"
                    Visibility="Collapsed"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    PointerWheelChanged="Paged_PointerWheelChanged"
                    Background="Transparent">
                    <StackPanel
                        x:Name="PagedHost"
                        Orientation="Horizontal"
                        Spacing="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,62,24,76">
                        <Border x:Name="SinglePageFrame" Background="Transparent">
                            <Grid>
                                <Image x:Name="SinglePageImage" Stretch="Uniform" />
                                <Canvas x:Name="SinglePageOverlay" Background="Transparent" />
                            </Grid>
                        </Border>
                        <Border x:Name="SecondPageFrame" Visibility="Collapsed" Background="Transparent">
                            <Grid>
                                <Image x:Name="SecondPageImage" Stretch="Uniform" />
                                <Canvas x:Name="SecondPageOverlay" Background="Transparent" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 连续滚动模式（MacPdfView 默认模式） -->
                <ScrollViewer
                    x:Name="ContinuousScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ViewChanged="ContinuousScroller_ViewChanged"
                    PointerWheelChanged="Continuous_PointerWheelChanged"
                    Background="Transparent">
                    <StackPanel x:Name="ContinuousStack" Spacing="12" HorizontalAlignment="Center" Padding="24,62,24,84" />
                </ScrollViewer>

                <!-- 错误提示 -->
                <TextBlock
                    x:Name="ErrorText"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13.5"
                    Foreground="{ThemeResource YYText2Brush}"
                    TextWrapping="Wrap"
                    MaxWidth="420" />

                <!-- 内联查词 / 翻译浮层锚点（避免隐藏 PdfSelectionCard 时导致 Flyout 自动关闭） -->
                <Border
                    x:Name="PdfPopoverAnchor"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Background="Transparent" />

                <!-- 划选 / 编辑 PDF 标注浮卡（对齐 dfdd801 ReaderCards.swift SelectionCard + MacPdfView.swift） -->
                <Border
                    x:Name="PdfSelectionCard"
                    Visibility="Collapsed"
                    Width="344"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="10,8"
                    CornerRadius="14"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="7">
                        <StackPanel x:Name="PdfSelNotePreviewBox" Visibility="Collapsed" Spacing="6" PointerPressed="PdfSelNotePreview_Pressed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource YYAccentBrush}" CornerRadius="1" />
                                <TextBlock x:Name="PdfSelNotePreviewText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource YYText1Brush}" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                <ContentPresenter x:Name="PdfSelNotePencilIcon" Grid.Column="2" VerticalAlignment="Center" Opacity="0.78" />
                            </Grid>
                            <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />
                        </StackPanel>

                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Tag="yellow" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="黄色划线" ToolTipService.ToolTip="黄色划线 (1)" Click="PdfMarkStyle_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <Border x:Name="PdfSwatchYellowRing" Width="22" Height="22" CornerRadius="11" Padding="1.5" BorderThickness="1.5" BorderBrush="Transparent">
                                            <Border CornerRadius="9" Background="#FBE7A0" BorderBrush="#22000000" BorderThickness="0.5" />
                                        </Border>
                                        <Border Width="16" Height="15" CornerRadius="4" Background="{ThemeResource YYInsetBrush}" HorizontalAlignment="Center">
                                            <TextBlock x:Name="PdfSwatchKey1" Text="1" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button Tag="blue" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="蓝色划线" ToolTipService.ToolTip="蓝色划线 (2)" Click="PdfMarkStyle_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <Border x:Name="PdfSwatchBlueRing" Width="22" Height="22" CornerRadius="11" Padding="1.5" BorderThickness="1.5" BorderBrush="Transparent">
                                            <Border CornerRadius="9" Background="#CFE6F4" BorderBrush="#22000000" BorderThickness="0.5" />
                                        </Border>
                                        <Border Width="16" Height="15" CornerRadius="4" Background="{ThemeResource YYInsetBrush}" HorizontalAlignment="Center">
                                            <TextBlock x:Name="PdfSwatchKey2" Text="2" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button Tag="pink" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="粉色划线" ToolTipService.ToolTip="粉色划线 (3)" Click="PdfMarkStyle_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <Border x:Name="PdfSwatchPinkRing" Width="22" Height="22" CornerRadius="11" Padding="1.5" BorderThickness="1.5" BorderBrush="Transparent">
                                            <Border CornerRadius="9" Background="#F6C7C0" BorderBrush="#22000000" BorderThickness="0.5" />
                                        </Border>
                                        <Border Width="16" Height="15" CornerRadius="4" Background="{ThemeResource YYInsetBrush}" HorizontalAlignment="Center">
                                            <TextBlock x:Name="PdfSwatchKey3" Text="3" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button Tag="wave" Padding="2" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="波浪线" ToolTipService.ToolTip="波浪线 (4)" Click="PdfMarkStyle_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                        <Border x:Name="PdfSwatchWaveRing" Width="22" Height="22" CornerRadius="11" Padding="1.5" BorderThickness="1.5" BorderBrush="Transparent">
                                            <Border CornerRadius="9" Background="{ThemeResource YYInsetBrush}" BorderThickness="0">
                                                <TextBlock Text="~" FontSize="12" FontWeight="Bold" Foreground="#EF7F71" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                            </Border>
                                        </Border>
                                        <Border Width="16" Height="15" CornerRadius="4" Background="{ThemeResource YYInsetBrush}" HorizontalAlignment="Center">
                                            <TextBlock x:Name="PdfSwatchKey4" Text="4" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="PdfLineUnderlineBtn" Tag="underline" Width="32" Height="30" Padding="0" CornerRadius="8" Background="{ThemeResource YYInsetBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="0.75" UseSystemFocusVisuals="False" AutomationProperties.Name="实线下划线" ToolTipService.ToolTip="实线下划线" Click="PdfMarkStyle_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="PdfLineUnderlineAText" Text="A" FontSize="13" FontWeight="SemiBold" LineHeight="13" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                        <Border x:Name="PdfLineUnderlineBar" Width="18" Height="2" CornerRadius="1" Background="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PdfLineDottedBtn" Tag="dotted" Width="32" Height="30" Padding="0" CornerRadius="8" Background="{ThemeResource YYInsetBrush}" BorderBrush="{ThemeResource YYLineBrush}" BorderThickness="0.75" UseSystemFocusVisuals="False" AutomationProperties.Name="点线下划线" ToolTipService.ToolTip="点线下划线" Click="PdfMarkStyle_Click">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="PdfLineDottedAText" Text="A" FontSize="13" FontWeight="SemiBold" LineHeight="13" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse x:Name="PdfLineDot1" Width="2.6" Height="2.6" Fill="{ThemeResource YYText1Brush}" />
                                            <Ellipse x:Name="PdfLineDot2" Width="2.6" Height="2.6" Fill="{ThemeResource YYText1Brush}" />
                                            <Ellipse x:Name="PdfLineDot3" Width="2.6" Height="2.6" Fill="{ThemeResource YYText1Brush}" />
                                            <Ellipse x:Name="PdfLineDot4" Width="2.6" Height="2.6" Fill="{ThemeResource YYText1Brush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PdfSelDeleteBtn" Visibility="Collapsed" Width="28" Height="28" Padding="0" CornerRadius="8" Background="{ThemeResource YYInsetBrush}" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="删除划线" ToolTipService.ToolTip="删除划线" Click="PdfSelDelete_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Height="0.5" Background="{ThemeResource YYLineBrush}" />

                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" HorizontalAlignment="Stretch" Height="41" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="写想法" Click="PdfSelNote_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PdfSelNoteIcon" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PdfSelNoteLabel" Text="写想法" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Height="41" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="复制" Click="PdfSelCopy_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PdfSelCopyIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="复制" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Height="41" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="从这听" Click="PdfSelSpeak_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PdfSelSpeakIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="从这听" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" HorizontalAlignment="Stretch" Height="41" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="查词" Click="PdfSelLookup_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PdfSelLookupIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="查词" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" HorizontalAlignment="Stretch" Height="41" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False" AutomationProperties.Name="翻译" Click="PdfSelTranslate_Click">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PdfSelTranslateIcon" HorizontalAlignment="Center" />
                                    <TextBlock Text="翻译" FontSize="11" Foreground="{ThemeResource YYText1Brush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 顶部撤销横幅 -->
                <Border
                    x:Name="ToastBanner"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,62,0,0"
                    Height="38"
                    Padding="12,0,10,0"
                    CornerRadius="19"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Border x:Name="ToastIconBadge" Width="17" Height="17" CornerRadius="8.5" Background="{ThemeResource YYAccentBrush}">
                            <ContentPresenter x:Name="ToastCheckIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ToastText" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource YYText1Brush}" VerticalAlignment="Center" />
                        <Button
                            x:Name="ToastUndoBtn"
                            Visibility="Collapsed"
                            Width="24"
                            Height="24"
                            Padding="0"
                            CornerRadius="12"
                            Background="{ThemeResource YYInsetBrush}"
                            BorderThickness="0"
                            AutomationProperties.Name="撤销"
                            ToolTipService.ToolTip="撤销 (Ctrl+Z)"
                            Click="ToastUndo_Click" />
                    </StackPanel>
                </Border>

                <!-- 底部常驻朗读胶囊（对齐 MacPdfView.capsule：308px 宽，左侧可点开 ListenCard，右侧 ‹ ▶ ›） -->
                <Border
                    x:Name="PdfCapsule"
                    Width="316"
                    Height="46"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Padding="5,4"
                    CornerRadius="23"
                    Background="{ThemeResource YYCardBrush}"
                    BorderBrush="{ThemeResource YYLineBrush}"
                    BorderThickness="0.5">
                    <Grid ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="CapsuleInfoBtn"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="36"
                            Padding="10,0"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderThickness="0"
                            UseSystemFocusVisuals="False"
                            AutomationProperties.Name="朗读设置"
                            ToolTipService.ToolTip="听：声音、速度、睡眠定时">
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="CapsuleTitleText" Text="第 1 / 1 页" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource YYText1Brush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CapsuleSubText" Text="点播放从这一页读起" FontSize="10" Foreground="{ThemeResource YYText2Brush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="ListenCardFlyout" Placement="Top" Opening="ListenCardFlyout_Opening">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="16,14" />
                                            <Setter Property="CornerRadius" Value="16" />
                                            <Setter Property="MinWidth" Value="380" />
                                            <Setter Property="MaxWidth" Value="400" />
                                            <Setter Property="Background" Value="{ThemeResource YYCardBrush}" />
                                            <Setter Property="BorderBrush" Value="{ThemeResource YYLineBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel x:Name="ListenCardHost" Width="348" Spacing="12" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            x:Name="CapsulePrevBtn"
                            Grid.Column="1"
                            Style="{StaticResource YYIconButtonStyle}"
                            Width="30"
                            Height="36"
                            CornerRadius="12"
                            AutomationProperties.Name="上一页或上一句"
                            ToolTipService.ToolTip="上一页 / 上一句"
                            Click="CapsuleStepPrev_Click" />

                        <Button
                            x:Name="CapsulePlayBtn"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            BorderThickness="0"
                            Background="{ThemeResource YYAccentBrush}"
                            UseSystemFocusVisuals="False"
                            AutomationProperties.Name="播放或暂停朗读"
                            ToolTipService.ToolTip="朗读这一页 (空格)"
                            Click="CapsuleTogglePlay_Click" />

                        <Button
                            x:Name="CapsuleNextBtn"
                            Grid.Column="3"
                            Style="{StaticResource YYIconButtonStyle}"
                            Width="30"
                            Height="36"
                            CornerRadius="12"
                            AutomationProperties.Name="下一页或下一句"
                            ToolTipService.ToolTip="下一页 / 下一句"
                            Click="CapsuleStepNext_Click" />
                    </Grid>
                </Border>

                <!-- 全屏底部 2px 进度细线 -->
                <Grid x:Name="FullScreenProgressBar" Visibility="Collapsed" VerticalAlignment="Bottom" Height="2" Background="Transparent">
                    <Border x:Name="FullScreenProgressFill" HorizontalAlignment="Left" Height="2" Width="0" Background="{ThemeResource YYAccentBrush}" />
                </Grid>
            </Grid>

            <!-- 右侧浮动面板卡（支持拖拽调节宽度，对齐 MacPdfView.swift YYResizeHandle） -->
            <design:YYResizeHandle
                x:Name="SidePanelResizeHandle"
                Grid.Column="1"
                Margin="-6,56,0,14"
                Visibility="Collapsed" />
            <Border
                x:Name="PdfSidePanel"
                Grid.Column="1"
                Visibility="Collapsed"
                Margin="0,56,14,14"
                CornerRadius="16"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="0.5"
                Padding="14,14,14,12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="PdfSideHeaderHost" Grid.Row="0" Spacing="8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PdfSideList" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 顶部悬浮工具栏（54px 高，仅含 < 书架、标题副标、右侧 4 图标胶囊：目录 / 笔记 / 书内搜索 / 显示） -->
        <Grid x:Name="TopBar" Height="54" VerticalAlignment="Top" Padding="14,0,148,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackToShelfBtn"
                Grid.Column="0"
                Height="30"
                Padding="9,0,12,0"
                CornerRadius="15"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="0.5"
                VerticalAlignment="Center"
                UseSystemFocusVisuals="False"
                AutomationProperties.Name="返回书架"
                Click="BackToShelf_Click">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ContentPresenter x:Name="IconBack" VerticalAlignment="Center" />
                    <TextBlock Text="书架" FontSize="12.5" Foreground="{ThemeResource YYText1Brush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent" Margin="12,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="BookTitleText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource YYText1Brush}"
                        TextTrimming="CharacterEllipsis"
                        HorizontalAlignment="Center"
                        MaxWidth="360" />
                    <TextBlock
                        x:Name="PageStatusText"
                        FontSize="10.5"
                        Foreground="{ThemeResource YYText2Brush}"
                        TextTrimming="CharacterEllipsis"
                        HorizontalAlignment="Center"
                        MaxWidth="420" />
                </StackPanel>
            </Grid>

            <Border
                x:Name="ToolCapsule"
                Grid.Column="2"
                Height="32"
                CornerRadius="16"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="0.5"
                VerticalAlignment="Center"
                Padding="3,0">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="PdfTocBtn" Style="{StaticResource YYIconButtonStyle}" Width="28" Height="26" CornerRadius="13" AutomationProperties.Name="目录" ToolTipService.ToolTip="目录" Click="PdfToc_Click" />
                    <Button x:Name="PdfNotesBtn" Style="{StaticResource YYIconButtonStyle}" Width="28" Height="26" CornerRadius="13" AutomationProperties.Name="划线和想法" ToolTipService.ToolTip="划线和想法" Click="PdfNotes_Click" />
                    <Button x:Name="PdfSearchBtn" Style="{StaticResource YYIconButtonStyle}" Width="28" Height="26" CornerRadius="13" AutomationProperties.Name="书内搜索" ToolTipService.ToolTip="书内搜索 (Ctrl+F)" Click="PdfSearch_Click" />
                    <Button x:Name="PdfShowBtn" Style="{StaticResource YYIconButtonStyle}" Width="28" Height="26" CornerRadius="13" AutomationProperties.Name="显示方式" ToolTipService.ToolTip="显示方式">
                        <Button.Flyout>
                            <Flyout x:Name="ShowCardFlyout" Placement="BottomEdgeAlignedRight" Opening="ShowCardFlyout_Opening" Closed="ShowCardFlyout_Closed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="16,14" />
                                        <Setter Property="CornerRadius" Value="16" />
                                        <Setter Property="MinWidth" Value="276" />
                                        <Setter Property="MaxWidth" Value="290" />
                                        <Setter Property="Background" Value="{ThemeResource YYCardBrush}" />
                                        <Setter Property="BorderBrush" Value="{ThemeResource YYLineBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel x:Name="ShowCardHost" Width="244" Spacing="12" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
