<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yuyue.Podcast.PodcastReaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="播客单集">

    <Grid x:Name="RootGrid" Background="{ThemeResource YYBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Padding="14,0,148,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Height="30"
                Padding="11,0"
                CornerRadius="15"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="1"
                UseSystemFocusVisuals="False"
                Click="BackToShelf_Click">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ContentPresenter x:Name="IconBack" VerticalAlignment="Center" />
                    <TextBlock Text="书架" FontSize="12.5" Foreground="{ThemeResource YYText1Brush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent" Margin="14,0">
                <TextBlock
                    x:Name="ShowNameTopText"
                    FontSize="12.5"
                    Foreground="{ThemeResource YYText2Brush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="PlayBtn" Style="{StaticResource YYPrimaryPillButtonStyle}" Height="28" Content="▶ 收听" Click="Play_Click" />
                <Button x:Name="RateBtn" Style="{StaticResource YYPillButtonStyle}" Height="28" Content="1.0×" Click="Rate_Click" />
            </StackPanel>
        </Grid>

        <!-- 杂志风长文阅读与摘录区 -->
        <Grid Grid.Row="1" Padding="24,8,24,20" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                CornerRadius="16"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="1">
                <ScrollViewer Padding="32,26" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="660">
                        <TextBlock x:Name="IssueShowBadge" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource YYAccentBrush}" />
                        <TextBlock x:Name="IssueTitleText" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource YYText1Brush}" TextWrapping="Wrap" LineHeight="31" />
                        <TextBlock x:Name="IssueSummaryText" FontSize="13.5" Foreground="{ThemeResource YYText2Brush}" TextWrapping="Wrap" LineHeight="22" />
                        <Border Height="1" Background="{ThemeResource YYLineBrush}" Margin="0,4" />
                        <StackPanel x:Name="TranscriptStack" Spacing="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧摘录栏 -->
            <Border
                Grid.Column="1"
                CornerRadius="16"
                Background="{ThemeResource YYCardBrush}"
                BorderBrush="{ThemeResource YYLineBrush}"
                BorderThickness="1"
                Padding="16,14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="节目摘录" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource YYText1Brush}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClipsStack" Spacing="8" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
