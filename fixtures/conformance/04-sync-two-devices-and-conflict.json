{
  "id": "04-sync-two-devices-and-conflict",
  "description": "Two devices merge disjoint settings, converge on progress, detect concurrent thought conflict, and resolve with Both.",
  "steps": [
    { "op": "open", "device": "a", "name": "Mac", "platform": "macos" },
    { "op": "open", "device": "b", "name": "Android", "platform": "android" },
    {
      "op": "import_book",
      "device": "a",
      "fixture": "books/beiying.epub",
      "save_as": "book"
    },
    {
      "op": "import_book",
      "device": "b",
      "fixture": "books/beiying.epub",
      "expect": { "same_id_as": "book" }
    },
    { "op": "set_reader_settings", "device": "a", "paper": "dark" },
    { "op": "set_reader_settings", "device": "b", "font_size": 22.0 },
    {
      "op": "add_mark",
      "device": "a",
      "book": "book",
      "section": 1,
      "start_sentence": 0,
      "start_offset": 0,
      "end_sentence": 0,
      "end_offset": 4,
      "text": "我与父亲",
      "style": "yellow",
      "note": "初稿",
      "save_as": "m1"
    },
    { "op": "sync", "from": "a", "to": "b", "min_changed": 1 },
    { "op": "sync", "from": "b", "to": "a", "min_changed": 1 },
    { "op": "assert_reader_settings", "device": "a", "paper": "dark", "font_size": 22.0 },
    { "op": "assert_reader_settings", "device": "b", "paper": "dark", "font_size": 22.0 },
    { "op": "sync", "from": "a", "to": "b", "exact_changed": 0 },
    { "op": "set_mark_note", "device": "a", "book": "book", "mark": "m1", "note": "甲的想法" },
    { "op": "sleep_ms", "ms": 5 },
    { "op": "set_mark_note", "device": "b", "book": "book", "mark": "m1", "note": "乙的想法" },
    { "op": "sync", "from": "a", "to": "b", "full": true },
    {
      "op": "assert_conflicts",
      "device": "b",
      "count": 1,
      "first_older_note": "甲的想法",
      "first_newer_note": "乙的想法"
    },
    { "op": "resolve_conflict", "device": "b", "book": "book", "mark": "m1", "choice": "both" },
    { "op": "assert_conflicts", "device": "b", "count": 0 },
    {
      "op": "assert_marks",
      "device": "b",
      "book": "book",
      "count": 1,
      "first_note": "甲的想法\n\n乙的想法"
    },
    { "op": "sync", "from": "b", "to": "a", "min_changed": 1 },
    {
      "op": "assert_marks",
      "device": "a",
      "book": "book",
      "count": 1,
      "first_note": "甲的想法\n\n乙的想法"
    }
  ]
}
