# 复制本文件为 .env 后填入你的视觉模型配置（.env 已被 .gitignore 忽略，切勿把真实 Key 填在本文件中）
# 配好后在 tests/midscene/ 目录先执行校验：
#   pnpm run model:verify
#
# Midscene 1.18.2 支持的常见视觉模型 MIDSCENE_MODEL_FAMILY 取值：
#   - Qwen-VL 系列: qwen3-vl / qwen3 / qwen3.5 / qwen3.6 / qwen2.5-vl / qwen4
#   - UI-TARS 系列: vlm-ui-tars / vlm-ui-tars-doubao / vlm-ui-tars-doubao-1.5
#   - GLM-V 系列:   glm-v / auto-glm / auto-glm-multilingual
#   - Gemini 系列:  gemini
# 完整说明见: https://www.midscenejs.com/model-config.html

# ==============================================================================
# 模板 1：魔搭社区 ModelScope API-Inference（国内直连，每日免费额度，推荐入门）
# ==============================================================================
MIDSCENE_MODEL_BASE_URL=https://api-inference.modelscope.cn/v1
MIDSCENE_MODEL_API_KEY=your-modelscope-access-token
MIDSCENE_MODEL_NAME=Qwen/Qwen3.5-35B-A3B
MIDSCENE_MODEL_FAMILY=qwen3.5

# ==============================================================================
# 模板 2：智谱 BigModel 长期免费 Flash 视觉模型（单并发，契合桌面串行测试）
# ==============================================================================
# MIDSCENE_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MIDSCENE_MODEL_API_KEY=your-zhipu-api-key
# MIDSCENE_MODEL_NAME=glm-4.6v-flash
# MIDSCENE_MODEL_FAMILY=glm-v

# ==============================================================================
# 模板 3：Ollama 本机部署（0 费用、无限流、隐私不出本机）
# 示例拉取：ollama pull qwen2.5vl:7b  或  ollama pull qwen3-vl:8b
# ==============================================================================
# MIDSCENE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MIDSCENE_MODEL_API_KEY=ollama
# MIDSCENE_MODEL_NAME=qwen3-vl:8b
# MIDSCENE_MODEL_FAMILY=qwen3-vl

# ==============================================================================
# 模板 4：vLLM / LM Studio / SGLang 本机部署 Qwen-VL 或 UI-TARS 1.5
# ==============================================================================
# MIDSCENE_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# MIDSCENE_MODEL_API_KEY=local-key
# MIDSCENE_MODEL_NAME=UI-TARS-1.5-7B
# MIDSCENE_MODEL_FAMILY=vlm-ui-tars
# MIDSCENE_MODEL_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}

# ==============================================================================
# 可选项：桌面显示与被测应用配置
# ==============================================================================
# 多显示器时可运行 `pnpm run displays` 查看 ID（如 \\.\DISPLAY1），留空默认主屏
COMPUTER_DISPLAY_ID=

# 可选：显式指定 Yuyue.exe 路径；留空时自动查找 windows/Yuyue/bin/.../Yuyue.exe
YUYUE_EXE=

# 可选：启用定位/规划缓存以加速重复回归（true / false）
# MIDSCENE_CACHE=true
